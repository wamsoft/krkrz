// サークル (universal) 遷移先の画面。中心から開き、中心へ閉じて戻る。
{
    "size": [960, 600],
    "background": [64, 40, 88, 255],
    "input": { "arrow_focus_nav": true },
    "transitions": {
        "back": { "target": "<back>", "effect": "universal",
                  "rule": "rule_circle_inv.png", "vague": 128, "duration": 700 },
        "": { "target": "<back>", "effect": "universal",
              "rule": "rule_circle_inv.png", "vague": 128, "duration": 700 }
    },
    "content": {
        "type": "align_center_middle",
        "child": { "type": "vtile", "children": [
            { "type": "label", "text": "UNIVERSAL / CIRCLE", "size": 56,
              "color": [230, 210, 255, 255],
              "animate": { "type": "scale", "from": [0.2, 0.2], "to": [1.0, 1.0],
                           "frames": 18, "easing": "out_back" } },
            { "type": "vspacer", "height": 12 },
            { "type": "label", "text": "放射グラデーション rule で中心から開く (vague 128)",
              "size": 22, "color": [190, 175, 220, 255] },
            { "type": "label", "text": "戻りは反転 rule で外周から中心へ閉じる",
              "size": 22, "color": [190, 175, 220, 255] },
            { "type": "vspacer", "height": 36 },
            { "type": "hsize", "width": 280, "child":
                { "type": "button", "id": "back", "text": "戻る (閉じるサークル)",
                  "close_on_click": true, "initial_focus": true } }
        ]}
    }
}
