// ----------------------------------------------------------------------
//  コア機能デモ定義リスト (src/core/data)
//
//  umbrella (krkrz_dev) の data/startup.tjs サンプルランチャがこのリストを
//  マージして表示する。Web (krkrz_web) ではこのフォルダが core/ として
//  合成されるため、ランチャからは core/samples.tjs として読まれる。
//
//  path  : このフォルダ直下のデモフォルダ名。"." はこのフォルダ自身
//          (直下の startup.tjs) を指す。
//  title : 一覧に表示する名前
//  desc  : 一行説明
//
//  ランチャは startup.tjs が実在するエントリだけを表示する。
// ----------------------------------------------------------------------
[
    %[ path : ".",
       title : "★ コアデモ ギャラリー (再起動なし切替)",
       desc : "sysinfo/フォント/ラスタライザ比較/画像処理/合成モード/入力/タイマー等を 1 プロセスで切替 (メニュー選択, fonts.json 読込済でカラー絵文字も可)" ],
    %[ path : "sysinfo",
       title : "システム情報",
       desc : "System/Storages の情報表示。demolib (デモ共通ヘルパ) の動作確認を兼ねる" ],
    %[ path : "elements_gallery",
       title : "Elements ギャラリー",
       desc : "Elements ウィジェットを実物 + 定義ソース + イベントログで確認できるカタログ" ],
    %[ path : "elements_flow",
       title : "Elements 画面遷移",
       desc : "Dialog フローの画面切替エフェクト (fade / universal + rule 画像) と exit 演出" ],
    %[ path : "gl_canvas",
       title : "OpenGL / Canvas 基礎",
       desc : "OGLDrawDevice + Canvas: テクスチャ/Matrix32/シェーダ/Offscreen/エフェクト/マスク" ],
    %[ path : "gl_particles",
       title : "GPU パーティクル",
       desc : "VertexBuffer + シェーダで数万粒子をステートレス描画。エミッタ/ブレンド切替・FPS 表示" ],
    %[ path : "layer_basic",
       title : "合成モードと不透明度",
       desc : "operateRect で 9 種の合成モード (加算/乗算/スクリーン/覆い焼き 等) を比較" ],
    %[ path : "layer_tree",
       title : "レイヤツリー / ヒットテスト / フォーカス",
       desc : "親子と重ね順、htMask/htProvince と hitThreshold、onHitTest、focusNext によるフォーカス連鎖" ],
    %[ path : "pad_advanced",
       title : "ゲームパッド (多パッド / 軸 / 振動)",
       desc : "論理番号 0=最後に操作したパッド、getPadAxis のスティック/トリガ可視化、VK_PAD* とホストホットキー、rumblePad、パッドオーバレイ" ],
    %[ path : "softkey_ime",
       title : "文字入力 / 仮想キーボード / IME",
       desc : "onTextInput で文字列を受ける、Layer.imeMode、内蔵仮想キーボード (Dialog.virtualKeyboard)、System.inputString、Clipboard" ],
    %[ path : "webui",
       title : "ブラウザ UI (WebServer)",
       desc : "内蔵 HTTP + SSE サーバでブラウザにツール UI を置く。静的配信 / 動的エンドポイント / ゲーム→ブラウザ push" ],
    %[ path : "system_debug",
       title : "デバッグ支援 (eval / 例外 / ログ)",
       desc : "Scripts.eval + Debug.prettyPrint で式を評価、例外オブジェクトの中身、System.exceptionHandler、Debug のログハンドラ" ],
    %[ path : "perf_stats",
       title : "転送コストとメモリ計測",
       desc : "System.renderStats の差分で画面転送コストを常時観測。負荷パターン切替 / PBO A/B / アロケータ情報" ],
    %[ path : "window_multi",
       title : "複数ウィンドウ / モーダル / 画面情報",
       desc : "サブウィンドウ生成と showModal (ブロッキング)、枠スタイル/最前面/表示倍率/全画面、解像度と DPI、画面 PNG 保存" ],
    %[ path : "input",
       title : "入力の可視化",
       desc : "キーボード/マウス/ゲームパッドの入力イベントをリアルタイム表示" ],
    %[ path : "image_ops",
       title : "画像処理",
       desc : "グレースケール/ガンマ/反転/ぼかし/アフィン/色掛けを before-after で比較" ],
    %[ path : "text_font",
       title : "フォントと文字描画",
       desc : "サイズ/装飾/アンチエイリアス/影/文字幅計測/フォント一覧" ],
    %[ path : "timer_async",
       title : "タイマーと非同期",
       desc : "Timer 周期・連続ハンドラ・AsyncTrigger の合流をタイミング可視化" ]
]
