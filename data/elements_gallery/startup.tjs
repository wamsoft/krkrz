// -*- mode:tjs2 -*-
// ======================================================================
//  elements_gallery — Elements ウィジェットギャラリー
// ----------------------------------------------------------------------
//  Elements (Dialog クラス) の主要ウィジェットを「実物 + 定義ソース +
//  イベントログ」の 3 点セットで確認できるカタログデモ。
//
//  単体起動用の薄いランチャ。実体は scene.tjs の ElementsGalleryScene、
//  ページ定義は pages.tjs (global GALLERY_PAGES)。束ね起動 (data/ ランチャ)
//  では scene.tjs だけを読み込む。
//
//  操作: ページ切替 = 上部ピッカー / ホイール = ソーススクロール / ESC = 終了
//
//  アトラス素材を再生成する場合: krkrz64.exe <このフォルダ> -genassets
// ======================================================================

var demolibPath = void;
{
    var cands = ["../demolib/", "../core/demolib/", "../../src/core/data/demolib/"];
    for (var i = 0; i < cands.count; i++) {
        if (Storages.isExistentStorage(cands[i] + "demo_common.tjs")) { demolibPath = cands[i]; break; }
    }
}
if (demolibPath === void) { System.inform("demolib が見つかりません"); System.exit(1); }
Scripts.execStorage(demolibPath + "demo_common.tjs");

// アトラス素材の再生成モード (-genassets) — 生成して System.exit する
if (System.getArgument("-genassets") !== void) {
    Scripts.execStorage("gen_assets.tjs");
}

Scripts.execStorage("pages.tjs");   // GALLERY_PAGES (単体では project 直下)
Scripts.execStorage("scene.tjs");

runDemoShell([new ElementsGalleryScene()], "elements_gallery — Elements ウィジェットギャラリー");
