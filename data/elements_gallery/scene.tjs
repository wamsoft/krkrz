// -*- mode:tjs2 -*-
// ======================================================================
//  elements_gallery シーン (ElementsGalleryScene)
//  Elements (ElementsDialog) の主要ウィジェットを「実物 + 定義ソース + イベントログ」
//  の 3 点セットで確認するカタログ。単体起動は startup.tjs、束ね起動は
//  data/ ランチャ。ページ定義は pages.tjs (global GALLERY_PAGES)。
// ======================================================================

// ページの中身 (pages.tjs の srcLines) は「そのまま写して使える定義ソース」を
// 画面に出すものなので訳さない。訳すのはギャラリーの枠側の文字列だけ。
I18n.add(%[
    "elements_gallery.title"     => %[ ja : "Elements ギャラリー",            en : "Elements gallery" ],
    "elements_gallery.shell"     => %[ ja : "elements_gallery — Elements ウィジェットギャラリー",
                                       en : "elements_gallery — Elements widget gallery" ],
    "elements_gallery.nopages"   => %[ ja : "pages.tjs が読み込めませんでした", en : "Could not load pages.tjs" ],
    "elements_gallery.nopages.info" => %[ ja : "pages.tjs 読み込み失敗",       en : "Failed to load pages.tjs" ],
    "elements_gallery.info"      => %[ ja : "ページ切替: 上部ピッカー   ホイール: ソーススクロール",
                                       en : "Switch page: top picker   Wheel: scroll source" ],
    "elements_gallery.noelem1"   => %[ ja : "この環境では ElementsDialog が利用できません", en : "ElementsDialog is not available here" ],
    "elements_gallery.noelem2"   => %[ ja : "KRKRZ_USE_ELEMENTS=ON でビルドした本体で", en : "Try an engine built with" ],
    "elements_gallery.noelem3"   => %[ ja : "お試しください",                  en : "KRKRZ_USE_ELEMENTS=ON" ],
    "elements_gallery.src"       => %[ ja : "定義ソース [${label}] — そのまま写して使えます",
                                       en : "Source [${label}] — copy and use as is" ],
    "elements_gallery.lines"     => %[ ja : "${from}〜 / ${count} 行",         en : "${from}- / ${count} lines" ],
    "elements_gallery.log"       => %[ ja : "イベントログ (onAction)",         en : "Event log (onAction)" ],
    "elements_gallery.p.basic"   => %[ ja : "基本",       en : "Basic" ],
    "elements_gallery.p.value"   => %[ ja : "値入力",     en : "Values" ],
    "elements_gallery.p.choice"  => %[ ja : "選択",       en : "Choice" ],
    "elements_gallery.p.layout"  => %[ ja : "レイアウト", en : "Layout" ],
    "elements_gallery.p.atlas"   => %[ ja : "atlas",      en : "atlas" ],
    "elements_gallery.p.anim"    => %[ ja : "アニメ",     en : "Anim" ],
    "elements_gallery.p.vars"    => %[ ja : "vars",       en : "vars" ]
]);

class ElementsGalleryScene extends DemoScene
{
    var currentPage = 0;
    var pendingPage;      // ピッカー操作の遅延反映
    var srcLayer;         // 右: ソースパネル
    var srcScroll = 0;
    var logLayer;         // 下: イベントログ
    var logLines = [];
    var actionCount = 0;
    var panelShown = false;

    var SRC_X = 704, SRC_W = 568, SRC_H = 572, LOG_H = 88;

    function ElementsGalleryScene() { super.DemoScene(I18n.entry("elements_gallery.title")); }

    function create()
    {
        // ページ定義 (GALLERY_PAGES) 読み込み。単体=project 直下、hub=配下。
        if (typeof global.GALLERY_PAGES == "undefined") {
            var cands = ["pages.tjs"];
            if (typeof global.demolibPath == "String")
                cands.add(global.demolibPath + "../elements_gallery/pages.tjs");
            for (var i = 0; i < cands.count; i++) {
                if (Storages.isExistentStorage(cands[i])) { Scripts.execStorage(cands[i]); break; }
            }
        }
        // atlas 資材 (atlas_ui.png) を自動検索パスへ。atlas は名前で参照するので
        // 画像フォルダ自体を登録する。単体=project 直下の image/、束ね起動では
        // elements_gallery/image/ を登録して同じ名前で解決できるようにする。
        Storages.addAutoPath("image/");
        if (typeof global.demolibPath == "String")
            Storages.addAutoPath(global.demolibPath + "../elements_gallery/image/");

        if (typeof global.GALLERY_PAGES == "undefined") {
            stage.font.height = 26;
            stage.drawText(40, 40, I18n.t("elements_gallery.nopages"), 0xd0a0a0, 255);
            stage.update();
            setInfo(I18n.t("elements_gallery.nopages.info"));
            return;
        }
        dm(@"elements_gallery: ${GALLERY_PAGES.count} page(s)");

        // 右: ソースパネル
        srcLayer = new Layer(window, stage);
        srcLayer.setSize(SRC_W, SRC_H); srcLayer.setPos(SRC_X, 8); srcLayer.visible = true;
        window.add(srcLayer);
        // 下: イベントログ
        logLayer = new Layer(window, stage);
        logLayer.setSize(stage.width, LOG_H);
        logLayer.setPos(0, stage.height - 44 - LOG_H); logLayer.visible = true;
        window.add(logLayer);

        setInfo(I18n.t("elements_gallery.info"));
        drawSource();
        drawLog();

        if (!hasElements()) {
            // 右のソースパネル (SRC_X から) に重ならないよう、左の欄の幅に収まる行に分ける
            stage.font.height = 24;
            stage.drawText(40, 40, I18n.t("elements_gallery.noelem1"), 0xd0a0a0, 255);
            stage.drawText(40, 76, I18n.t("elements_gallery.noelem2"), 0x9aa4b8, 255);
            stage.drawText(40, 106, I18n.t("elements_gallery.noelem3"), 0x9aa4b8, 255);
            stage.update();
        }
        showGallery();
    }

    // --- ギャラリーダイアログ -------------------------------------------
    // ページ名 (表に "elements_gallery.p.<id>" があれば訳、無ければ pages.tjs の label)
    function pageLabel(i)
    {
        var id = "elements_gallery.p." + GALLERY_PAGES[i].id;
        return (I18n.table[id] !== void) ? I18n.t(id) : GALLERY_PAGES[i].label;
    }
    function pageLayout(i) { return Scripts.eval(GALLERY_PAGES[i].srcLines.join("\n")); }

    function buildGalleryDict()
    {
        var opts = [];
        for (var i = 0; i < GALLERY_PAGES.count; i++) opts.add(pageLabel(i));
        var page = pageLayout(currentPage);
        var dict = %[
            size : [684, 580], background : [28, 30, 40, 240],
            align : "top_left", margin : 10, input : %[ arrow_focus_nav : true ],
            content : %[
                type : "margin", padding : 12,
                child : %[ type : "vtile", children : [
                    %[ type : "vsize", height : 0, child : %[ type : "hspacer", width : 644 ] ],
                    %[ type : "align_center",
                       child : %[ type : "label", text : I18n.t("elements_gallery.title"), size_scale : 1.4 ] ],
                    %[ type : "vspacer", height : 8 ],
                    %[ type : "segmented_picker", id : "page", options : opts, initial : currentPage ],
                    %[ type : "vspacer", height : 10 ],
                    page.content
                ] ]
            ]
        ];
        if (page.vars !== void) dict.vars = page.vars;
        if (page.atlases !== void) dict.atlases = page.atlases;
        return dict;
    }

    function showGallery() { panelShown = showPanelDict(buildGalleryDict()); }

    // --- イベント処理 ---------------------------------------------------
    function fmtPayload(p)
    {
        switch (typeof p) {
        case "void":   return "(void)";
        case "String": return "\"" + p + "\"";
        case "Real":   return "%.3f".sprintf(p);
        default:       return "" + p;
        }
    }

    function onPanelAction(id, payload)
    {
        actionCount++;
        logAction(@"onAction( id:\"${id}\", payload:${fmtPayload(payload)} )");
        if (id == "page") {
            var i = Math.floor(+payload);
            if (i >= 0 && i < GALLERY_PAGES.count && i != currentPage) pendingPage = i;
        }
    }

    function onDemoFrame(tick)
    {
        if (pendingPage !== void) {
            currentPage = pendingPage; pendingPage = void; srcScroll = 0;
            showGallery(); drawSource();
        }
    }

    // --- ソースパネル ---------------------------------------------------
    function drawSource()
    {
        var lay = srcLayer;
        lay.fillRect(0, 0, SRC_W, SRC_H, 0xff1a1d26);
        lay.fillRect(0, 0, SRC_W, 34, 0xff242938);
        var page = GALLERY_PAGES[currentPage];
        lay.font.height = 19;
        lay.drawText(12, 7, I18n.t("elements_gallery.src", %[ label : pageLabel(currentPage) ]), 0x9fc0e8, 255);
        lay.font.height = 16;
        var lineH = 19;
        var maxLines = ((SRC_H - 42) / lineH) \ 1;
        var lines = page.srcLines;
        if (srcScroll > lines.count - maxLines) srcScroll = lines.count - maxLines;
        if (srcScroll < 0) srcScroll = 0;
        for (var i = 0; i < maxLines; i++) {
            var li = srcScroll + i;
            if (li >= lines.count) break;
            lay.drawText(14, 40 + i * lineH, lines[li], 0xc0c8d8, 255);
        }
        if (lines.count > maxLines) {
            lay.font.height = 14;
            lay.drawText(SRC_W - 120, 10, I18n.t("elements_gallery.lines", %[ from : srcScroll + 1, count : lines.count ]), 0x60708c, 255);
        }
        lay.update();
    }

    // --- イベントログ ---------------------------------------------------
    function logAction(text)
    {
        dm("gallery " + text);
        logLines.add("%4d".sprintf(actionCount) + "  " + text);
        while (logLines.count > 3) logLines.erase(0);
        drawLog();
    }

    function drawLog()
    {
        var lay = logLayer;
        lay.fillRect(0, 0, lay.width, LOG_H, 0xff10141c);
        lay.fillRect(0, 0, lay.width, 2, 0xff2c3444);
        lay.font.height = 16;
        lay.drawText(12, 6, I18n.t("elements_gallery.log"), 0x8fa8d0, 255);
        lay.font.height = 17;
        for (var i = 0; i < logLines.count; i++)
            lay.drawText(24, 26 + i * 20, logLines[i], 0xd8e0a0, 255);
        lay.update();
    }

    // --- 入力 -----------------------------------------------------------
    function onMouseWheel(shift, delta, x, y) { srcScroll -= (delta / 120); drawSource(); }

    // --- -demotest 検証出力 ---------------------------------------------
    function onDemoTest()
    {
        dm(@"@demotest:gallery pages=${GALLERY_PAGES.count} panel=${panelShown ? 1 : 0} page=${currentPage} actions=${actionCount}");
    }
}
