{
    /* システム系サンプル。 セーブ / ロードは Storages、 情報はコンソール出力。 */
    "size": [460, 320],
    "background": [34, 30, 26, 248],
    "locale": "ja-JP",
    "align": "top_left",
    "margin": 24,
    "input": { "arrow_focus_nav": true },

    "transitions": {
        "back": "<back>",
        "":     "<back>",
    },

    "content": {
        "type": "margin", "padding": 22,
        "child": {
            "type": "vtile",
            "children": [
                { "type": "vsize", "height": 0, "child": { "type": "hspacer", "width": 416 } },
                { "type": "align_center",
                  "child": { "type": "label", "text": "システム", "size": 1.3 } },
                { "type": "vspacer", "height": 16 },

                { "type": "vsize", "height": 42, "child": {
                    "type": "button", "id": "save", "text": "セーブ",
                    "initial_focus": true } },
                { "type": "vspacer", "height": 8 },
                { "type": "vsize", "height": 42, "child": {
                    "type": "button", "id": "load", "text": "ロード" } },
                { "type": "vspacer", "height": 8 },
                { "type": "vsize", "height": 42, "child": {
                    "type": "button", "id": "info", "text": "システム情報を表示" } },

                { "type": "vspacer", "height": 14 },
                { "type": "vsize", "height": 38, "child": {
                    "type": "button", "id": "back", "text": "← 戻る",
                    "close_on_click": true } },
            ],
        },
    },
}
