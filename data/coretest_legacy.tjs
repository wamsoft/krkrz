var date = new Date();
var fmt  = "%d %04d/%02d/%02d %02d:%02d";
with(date) { 
    var text = fmt.sprintf(.getTime(),
			.getYear(),  .getMonth() + 1, .getDate(),
			.getHours(), .getMinutes());
    dm(text);
};

