// ----------------------------------------------------------------------
// 共通ダイアログサンプル — VK_D / VK_E / VK_O で同じ JSON を使ってフォーカス
// 挙動を比較しやすくする
// ----------------------------------------------------------------------
function commonDialogJson()
{
    return @'
    {
        /* JSONC 対応: 行コメントとブロックコメント、 末尾カンマが
           使えるようになった (picojson の前段で strip する仕組み)。 */
        "size": [560, 600],
        "background": [40, 40, 50, 240],
        "locale": "ja-JP",

        /* 入力設定 (Elements 新 API):
             arrow_focus_nav: 矢印キー / アナログスティック (focus モード) で
                              2D フォーカス移動を有効化
             pad_bindings:    pad ボタン → key の override (デフォルト
                              A=Enter / B=Esc / X=Shift+Tab / Y=Tab)
             shortcuts:       任意 key/pad → 要素 id のショートカット。
                              LB / RB を直接 OK / Cancel ボタンに割当てる。 */
        "input": {
            "arrow_focus_nav": true,
            "dpad_mode":        "both",
            "left_stick_mode":  "focus",
            "right_stick_mode": "value",
            "shortcuts": [
                { "pad": "lb", "target": "cancel" },
                { "pad": "rb", "target": "ok", "force": true }
            ]
        },

        "content": {
            "type": "margin", "padding": 16,
            "child": {
                "type": "vtile",
                "children": [
                    // つっかえ棒: vtile の幅を 528 (= 560 - margin 16*2) で
                    // 強制し、 ダイアログ全体を 560 幅にする。
                    { "type": "vsize", "height": 0, "child": { "type": "hspacer", "width": 528 } },

                    { "type": "align_center",
                      "child": { "type": "label",
                                 "text": "Elements ウィジェットデモ",
                                 "size": 1.3 } },

                    { "type": "group", "title": "ボタン",
                      "child": { "type": "margin", "padding": [10, 45, 10, 10],
                                 "child": { "type": "htile",
                                            "children": [
                                                /* close_on_click 省略 = false
                                                   → click しても modal は閉じず、
                                                     onAction だけ発火する */
                                                { "type": "hsize", "width": 120,
                                                  "child": { "type": "button",
                                                             "id": "hello", "text": "こんにちは" } },
                                                { "type": "hsize", "width": 120,
                                                  "child": { "type": "toggle_button",
                                                             "id": "togA", "text": "切り替え" } }
                                            ] } } },

                    { "type": "group", "title": "選択",
                      "child": { "type": "margin", "padding": [10, 45, 10, 10],
                                 "child": { "type": "vtile",
                                            "children": [
                                                { "type": "align_left",
                                                  "child": { "type": "checkbox",
                                                             "id": "cb1",
                                                             "text": "機能 A を有効化",
                                                             "value": true } },
                                                { "type": "align_left",
                                                  "child": { "type": "checkbox",
                                                             "id": "cb2",
                                                             "text": "機能 B を有効化 (Enable B)" } },
                                                { "type": "align_left",
                                                  "child": { "type": "htile",
                                                             "children": [
                                                                 { "type": "label",
                                                                   "text": "電源 Power " },
                                                                 { "type": "slide_switch",
                                                                   "id": "sw1",
                                                                   "value": true }
                                                             ] } }
                                            ] } } },

                    { "type": "group", "title": "テキスト入力",
                      "child": { "type": "margin", "padding": [10, 45, 10, 10],
                                 "child": { "type": "vsize", "height": 30,
                                            "child": { "type": "input_box",
                                                       "id": "name",
                                                       "placeholder": "お名前を入力..." } } } },

                    { "type": "group", "title": "Locale 比較 (同じ Han 字コード)",
                      "child": { "type": "margin", "padding": [10, 45, 10, 10],
                                 "child": { "type": "vtile",
                                            "children": [
                                                { "type": "align_left",
                                                  "child": { "type": "label",
                                                             "text": "ja-JP : 直 骨 次 海 雪 公",
                                                             "locale": "ja-JP" } },
                                                { "type": "align_left",
                                                  "child": { "type": "label",
                                                             "text": "zh-TW : 直 骨 次 海 雪 公",
                                                             "locale": "zh-TW" } }
                                            ] } } },

                    { "type": "align_right",
                      "child": { "type": "htile",
                                 "children": [
                                     { "type": "hsize", "width": 110,
                                       /* initial_focus: 起動時にここへフォーカス。
                                          close_on_click: true で modal を閉じる
                                          (デフォルト false の button は閉じない、
                                           onAction だけ発火する)。 */
                                       "child": { "type": "button", "initial_focus": true,
                                                  "close_on_click": true,
                                                  "id": "ok", "text": "OK" } },
                                     { "type": "hsize", "width": 110,
                                       "child": { "type": "button",
                                                  "close_on_click": true,
                                                  "id": "cancel", "text": "キャンセル" } }
                                 ] } }
                ]
            }
        }
    }
    ';
}

// ----------------------------------------------------------------------
// VK_D: 非同期オーバーレイダイアログ (ElementsDialog.showJson, onAction で受ける)
// ----------------------------------------------------------------------
class TestDialog extends ElementsDialog
{
    function TestDialog() { super.ElementsDialog(); }
    function onAction(id, payload) {
        dm(@"ElementsDialog action: ${id} payload=${payload}");
        switch (id) {
        case "ok":
            System.inform("OK pressed");
            close();
            break;
        case "cancel":
            close();
            break;
        }
    }
}

var dialogTestInstance = void;

function dialogTest()
{
    if (dialogTestInstance !== void) invalidate dialogTestInstance;
    dialogTestInstance = new TestDialog();
    dialogTestInstance.showJson(commonDialogJson());
}

// ----------------------------------------------------------------------
// VK_K: SoftKeyboard (softkey プラグイン) — Elements ベース英数字キーボード
// ----------------------------------------------------------------------
var softKeyInstance = void;

function softkeyTest()
{
    if (typeof global.SoftKeyboard == "undefined") {
        dm("softkey plugin not linked");
        return;
    }
    if (softKeyInstance === void) {
        softKeyInstance = new SoftKeyboard();
        softKeyInstance.onResult = function(text) {
            if (text === void) dm("softkey: canceled");
            else dm(@"softkey: result='${text}'");
        };
    }
    if (!softKeyInstance.show(%["text" => "ABC", "maxLength" => 12,
                                "title" => "NAME ENTRY"])) {
        dm("softkey: show failed (already active?)");
    }
}

// ----------------------------------------------------------------------
// showModal* 用ハンドラ。 close_on_click=false な button (hello / togA 等) の
// 押下を観測する用。 ok / cancel は元々 close_on_click=true なので modal が
// 閉じてから result.action として帰ってくる (それも一応 onAction にも来る)。
// ----------------------------------------------------------------------
class ModalActionDialog extends ElementsDialog
{
    function ModalActionDialog() { super.ElementsDialog(); }
    function onAction(id, payload) {
        dm(@"  modal onAction: id=${id} payload=${payload}");
    }
}

// ----------------------------------------------------------------------
// VK_E: 独立 SDL_Window モーダル (showModalJson with title, ブロッキング)
// ----------------------------------------------------------------------
function modalTest()
{
    var dlg = new ModalActionDialog();
    var result = dlg.showModalJson(commonDialogJson(),
        "モーダルテスト (独立 window)", 560, 700);

    if (result === void) {
        System.inform("modal failed");
        return;
    }
    dm(@"Modal (window) result: action='${result.action}'");
    System.inform(@"window modal: action=${result.action}");
}

// ----------------------------------------------------------------------
// VK_O: オーバーレイモーダル (showModalJson 1 引数、 ゲーム window 上に被せる)
// ----------------------------------------------------------------------
function modalOverlayTest()
{
    var dlg = new ModalActionDialog();
    var result = dlg.showModalJson(commonDialogJson());

    if (result === void) {
        System.inform("overlay modal failed");
        return;
    }
    dm(@"Modal (overlay) result: action='${result.action}'");
    System.inform(@"overlay modal: action=${result.action}");
}

// ----------------------------------------------------------------------
// navigator フロー用ハンドラ。 onScreen / onScreenLeave で画面遷移を観測し、
// onAction で各画面の widget 値変化 / click を受ける。
// ----------------------------------------------------------------------
class FlowDialog extends ElementsDialog
{
    function FlowDialog() { super.ElementsDialog(); }
    function onScreen(name)          { dm(@"  flow enter: ${name}"); }
    function onScreenLeave(name, act){ dm(@"  flow leave: ${name} (action='${act}')"); }
    function onAction(id, payload)   { dm(@"  flow action: id=${id} payload=${payload}"); }
}

// ----------------------------------------------------------------------
// VK_F: マニフェスト駆動の複数画面フロー (ElementsDialog.showFlow, ブロッキング overlay)
//   data/ui/app.jsonc → menu → settings / about を push / pop で遷移。
// ----------------------------------------------------------------------
function flowTest()
{
    var dlg = new FlowDialog();
    var result = dlg.showFlow("ui/flowdemo.jsonc");
    if (result === void) {
        System.inform("flow failed");
        return;
    }
    dm(@"Flow result: action='${result.action}'");
    System.inform(@"flow done: action=${result.action}");
}

// ----------------------------------------------------------------------
// VK_G: インライン駆動の複数画面フロー (ElementsDialog.showFlowScreens)
//   ファイル I/O なし。 画面名→JSON文字列の辞書 + 起点画面名で遷移。
// ----------------------------------------------------------------------
function flowInlineTest()
{
    // TJS 辞書リテラルは comma 形式 (key, value, ...)。 colon 形式は識別子キー
    // 限定なので、 文字列キーはこの形で渡す。
    var screens = %[
        "main", @'{
            "size": [380, 240], "background": [28,30,40,245], "locale": "ja-JP",
            "input": { "arrow_focus_nav": true },
            "transitions": { "next": "second", "": "<exit>" },
            "content": { "type": "margin", "padding": 20, "child": {
                "type": "vtile", "children": [
                    { "type": "vsize", "height": 0, "child": { "type": "hspacer", "width": 340 } },
                    { "type": "align_center", "child": {
                        "type": "label", "text": "インライン画面 1", "size": 1.3 } },
                    { "type": "vspacer", "height": 20 },
                    { "type": "vsize", "height": 40, "child": {
                        "type": "button", "id": "next", "text": "次へ",
                        "close_on_click": true, "initial_focus": true } } ] } }
        }',
        "second", @'{
            "size": [380, 240], "background": [40,30,40,245], "locale": "ja-JP",
            "input": { "arrow_focus_nav": true },
            "transitions": { "back": "<back>", "done": "<exit>", "": "<back>" },
            "content": { "type": "margin", "padding": 20, "child": {
                "type": "vtile", "children": [
                    { "type": "vsize", "height": 0, "child": { "type": "hspacer", "width": 340 } },
                    { "type": "align_center", "child": {
                        "type": "label", "text": "インライン画面 2", "size": 1.3 } },
                    { "type": "vspacer", "height": 20 },
                    { "type": "vsize", "height": 40, "child": {
                        "type": "button", "id": "back", "text": "戻る",
                        "close_on_click": true, "initial_focus": true } },
                    { "type": "vspacer", "height": 10 },
                    { "type": "vsize", "height": 40, "child": {
                        "type": "button", "id": "done", "text": "完了",
                        "close_on_click": true } } ] } }
        }'
    ];
    var dlg = new FlowDialog();
    var result = dlg.showFlowScreens(screens, "main");
    if (result === void) {
        System.inform("inline flow failed");
        return;
    }
    dm(@"Inline flow result: action='${result.action}'");
    System.inform(@"inline flow done: action=${result.action}");
}

// ----------------------------------------------------------------------
// ジャンル別サンプルメニュー (navigator フロー) のハンドラ。
//   onScreen / onScreenLeave で画面遷移を、 onAction で各 widget を観測する。
//   サンプルの起動はフロー終了後に MyWindow.dispatchSample が result.action を
//   見て行う (フローの nested pump 中に modal を多重起動しないため)。
// ----------------------------------------------------------------------
class FlowMenuDialog extends ElementsDialog
{
    var win;
    function FlowMenuDialog(w) { super.ElementsDialog(); win = w; }
    function onScreen(name)            { dm(@"  menu screen: ${name}"); }
    function onScreenLeave(name, act)  { dm(@"  menu leave: ${name} (action='${act}')"); }
    // close_on_click 無しの button click はここに来る (メニューは閉じない)。
    // サンプル起動はウィンドウ側 dispatchSample に委譲。
    function onAction(id, payload) {
        dm(@"  menu action: ${id} payload=${payload}");
        if (win !== void) win.dispatchSample(id);
    }
}


// ----------------------------------------------------------------------
// 非モーダル情報パネル (複数同時表示デモ用)。
//   ジャンルメニュー (top_left) とは別インスタンスとして bottom_right に常駐し、
//   両方を同時に出しっぱなしにできることを示す。 各パネルは独立にヒットテスト
//   されるので、 メニューをクリックすればメニューが、 パネルをクリックすれば
//   パネルが反応する (どちらにも当たらないクリックはゲーム背景へ素通し)。
// ----------------------------------------------------------------------
class InfoPanelDialog extends ElementsDialog
{
    var win;
    function InfoPanelDialog(w) { super.ElementsDialog(); win = w; }
    function onScreen(name)           { dm(@"  panel screen: ${name}"); }
    function onScreenLeave(name, act) { dm(@"  panel leave: ${name} (action='${act}')"); }
    function onAction(id, payload) {
        dm(@"  panel action: ${id}");
        // 閉じない button は onAction だけ来る。 パネルからも BGM を操作できる
        // ことで、 メニューと独立に動く非モーダル UI であることを示す。
        if (id == "bgm" && win !== void) win.soundTest();
    }
}


class MyWindow extends Window
{
    var primaryLayer;
    var base1;
    var base2;

    var layer1, layer2, layer3, layer4;

    var timer;
    var start_tick;
    var sound;
    var phaseVocoder;
    var soundSpeed = 1.0;
    var soundPlayRequested = false;
    var soundOpened = false;
    var soundStorage = "bgm01_dummy.ogg";
    var seStorage = "se_dummy.ogg";

	var bg;
	var ev;
    var text;
    var videolay;
    var video;

    // --- 動画プレイヤサンプル (ファイル選択して視聴) 用 ---
    var mpVideo;         // 再生中の VideoOverlay
    var mpPaused = false; // 一時停止中か

    // --- 3D 音声デモ用 ---
    var snd3d;          // WaveSoundBuffer (3D 音源)
    var snd3dTimer;     // 位置更新タイマ
    var snd3dLayer;     // 可視化レイヤ (リスナ + 音源)
    var snd3dX = -15.0; // 音源のワールド X (フライバイで -15→+15 を往復)
    var snd3dZ = -3.0;  // 音源のワールド Z (リスナ前方に固定。前方 = -Z)
    var snd3dSpeed = 7.5;   // X 方向速度 (units/sec)。ドップラー用速度にも使う
    var snd3dDoppler = true;
    var snd3dModel = amInverse;
    var snd3dMode = 0;      // 0=フライバイ(左右往復), 1=周回(リスナの周りをぐるぐる)
    var snd3dAngle = 0.0;   // 周回モードの角度 (rad)
    var snd3dRadius = 8.0;  // 周回半径 (units)
    // 周回時の前後距離バイアス (前=近, 後=遠)。マルチチャンネル(5.1/7.1)出力では
    // spatializer が前後を実スピーカーへ定位できるので 0=真円が正しい。ステレオ出力は
    // 前後を区別できない(中央パン)ので、その環境では >0 にすると距離差で前後感を補える。
    var snd3dFrontBias = 0.0;

    var saveDataLocation;

    function createBaseLayer() {
        var lay = new BaseLayer(this, primaryLayer);
        lay.setSize(WIDTH, HEIGHT);
        lay.fillRect(0,0,lay.width,lay.height,0x00000000);
        add(lay);
        return lay;
    }

    function MyWindow() {
        super.Window(...);

        if (false && typeof global.Window.BasicDrawDevice == "undefined") {
            drawDevice = new MyDrawDevice();
            this.waitVSync = true;
        }
        this.waitVSync = true;

        setInnerSize(WIDTH, HEIGHT);
        primaryLayer = new Layer(this, null);
        primaryLayer.setSize(WIDTH, HEIGHT);
        // デバッグ用: 全面を紺で塗ったあと 64px 単位でグリッド線、中心に十字
        // (赤=水平方向中心軸、緑=垂直方向中心軸)。ダイアログ位置のセンタ
        // リング確認用。
        primaryLayer.fillRect(0, 0, WIDTH, HEIGHT, 0xff202040);
        var gridColor = 0xff404060;
        for (var x = 0; x <= WIDTH; x += 64) {
            primaryLayer.fillRect(x, 0, 1, HEIGHT, gridColor);
        }
        for (var y = 0; y <= HEIGHT; y += 64) {
            primaryLayer.fillRect(0, y, WIDTH, 1, gridColor);
        }
        primaryLayer.fillRect((WIDTH \ 2) - 1, 0, 3, HEIGHT, 0xffff4040);
        primaryLayer.fillRect(0, (HEIGHT \ 2) - 1, WIDTH, 3, 0xff40ff40);
        add(primaryLayer);

        if (drawDevice instanceof "OGLDrawDevice") {
            primaryLayer.type = ltAlpha; 
        }

        base1 = createBaseLayer();
        base1.visible = true;
        base2 = createBaseLayer();

        bg = new Layer(this, base2);
        bg.loadImages("bg.jpg");
		bg.setSizeToImageSize();
        bg.visible = true;
        add(bg);

        ev = new Layer(this, base2);
        ev.loadImages("fg.png");
		ev.setSizeToImageSize();
        ev.visible = true;
        add(ev);

        var layer1_color = 0xffff0000;
        var layer2_color = 0x800000ff;
        var layer3_color = 0x8000ff00;
        var layer4_color = 0x80ff0000;
    
        layer2 = new Layer(this, base1);
        layer2.setSize(400,400);
        layer2.setPos(100,100);
        layer2.fillRect(0,0,400,400,layer2_color);
        layer2.type = ltAlpha;
        layer2.visible = true;
        add(layer2);
        
        layer3 = new Layer(this, base1);
        layer3.setSize(400,400);
        layer3.setPos(400,200);
        layer3.fillRect(0,0,400,400,layer3_color);
        layer3.type = ltAlpha;
        layer3.visible = true;
        add(layer3);
        
        layer4 = new Layer(this, base1);
        layer4.setSize(400,400);
        layer4.setPos(700,300);
        layer4.fillRect(0,0,400,400,layer4_color);
        layer4.type = ltAlpha;
        layer4.visible = true;
        add(layer4);

        layer1 = new Layer(this, base1);
        layer1.setSize(600,600);
        layer1.fillRect(0,0,600,600,layer1_color);
        layer1.setPos(300,300);
        layer1.type = ltAlpha;
        layer1.visible = true;
        add(layer1);

        sound = new WaveSoundBuffer(this);
        sound.onStatusChanged = function() {
            dm(@"bgm status change:${this.status}");
        } incontextof sound;
        phaseVocoder = new WaveSoundBuffer.PhaseVocoder();
        phaseVocoder.time = soundSpeed;
        phaseVocoder.pitch = 1.0;
        sound.filters.clear();
        sound.filters.add(phaseVocoder);
        dm(@"PhaseVocoder speed:${soundSpeed}");

        timer = new Timer(this, "onTimer");
        timer.interval = 1000/60;
        dm(@"Timer created: ${timer.interval}ms interval");

        saveDataLocation = System.dataPath;
        dm(@"セーブデータ場所:${saveDataLocation}");

        fontText();

        System.addContinuousHandler(onContinuous);
    }

    var frameCount;
    var prevTick;
    var fps;    

    function calcFPS() {
        frameCount++;
        var tick = System.getTickCount();
        if (prevTick === void) prevTick = tick;
        var time = tick - prevTick;
        if (time >= 1000) {
            fps = frameCount * 1000 / time;
            frameCount = 0;
            prevTick = tick;
            this.caption = @"fps:${fps}";
        }
    }

    var contCount = 0;

    function onContinuous() {
        //dm(@"onContinuous:${contCount++}");
        calcFPS();
        // 保留サンプルがあり、 メニュー (= manager) の teardown が済んだら起動。
        // close() は次フレーム teardown なので active が false になるまで待つ。
        if (pendingSample !== void && (menuDlg === void || !menuDlg.active)) {
            var s = pendingSample;
            pendingSample = void;
            runDeferredSample(s);
        }
    }

    function drawDeviceChange() {
        if (typeof global.Window.BasicDrawDevice == "undefined") {
            return;
        }
        if (drawDevice instanceof "BasicDrawDevice") {
            dm("OGLDrawDeviceに変更");
            drawDevice = new MyDrawDevice();
            primaryLayer.type = ltAlpha; 
            this.waitVSync = true;
        } else {
            dm("BasicDrawDeviceに戻す");
            drawDevice = new global.Window.BasicDrawDevice();
            primaryLayer.type = ltOpaque; 
        }
    }

    function onStatusChanged(status) {
        dm(@"bgm status change:${status}");
    }

     function saveTest() {
        var saveFile = saveDataLocation + "savedata.txt";
        var data = %["test","abc", "array",[1,2,3,4,5]];
        try {
            dm(@"セーブ処理実行:${saveFile}");
            (Dictionary.saveStruct incontextof data)(saveFile);
            Storages.commitSavedata();
        } catch(e) {
            dm(@"セーブ処理失敗:${e.message}");
            Storages.rollbackSavedata();
        }
    }

    function loadTest() {
        var saveFile = saveDataLocation + "savedata.txt";
        var data;
        try {
            dm(@"ロード処理実行:${saveFile}");
            data = Scripts.evalStorage(saveFile);
            dm(@"dataload:${Scripts.toStructString(data)}");
        } catch(e) {
            dm(@"ロード処理失敗:${e.message}");
        }
    }

    function onTimer() {
        var tick = System.getTickCount() - start_tick;
        var alpha = 255 * (Math.sin(2*Math.PI * tick/4000.0) + 1) / 2;
        dm(@"tick:${tick} alpha:${alpha}");
        layer1.opacity = alpha;
    }

    function soundTest() {
        soundPlayRequested = !soundPlayRequested;
        if (soundPlayRequested) {
            if (!soundOpened) {
                sound.open(soundStorage);
                soundOpened = true;
            }
            if (sound.status != "play") {
                sound.play();
            }
        } else {
            if (sound.status == "play") {
                sound.stop();
            }
        }
    }

    function updateSoundSpeed(delta) {
        var wasPlaying = (sound.status == "play");

        soundSpeed += delta;
        if (soundSpeed < 0.25) soundSpeed = 0.25;
        if (soundSpeed > 2.0) soundSpeed = 2.0;

        if (phaseVocoder !== void) {
            phaseVocoder.time = soundSpeed;
        }

        if (wasPlaying) {
            sound.stop();
            sound.open(soundStorage);
            soundOpened = true;
            sound.play();
        }

        dm(@"PhaseVocoder speed:${soundSpeed}");
    }

    function seTest() {
        sound.stop();
        sound.open(seStorage);
        sound.play();
    }

    function timerTest() {
        if (timer.enabled) {
            timer.enabled = false;
            layer1.opacity = 255;
        } else {
            start_tick = System.getTickCount();
            dm(@"start_tick:${start_tick}");
            timer.enabled = true;
        }
    }

    function videoTest0() {
        if (video) {
            video.stop();
            video.close();
            video = void;
        } else {
            video = new VideoOverlay(this);
            video.onStatusChanged = function(status) {
                dm(@"video status change:${status}");
            } incontextof video;
            video.mode = vomMixer;
            video.open("title.webm");
            video.visible = true;   // overlay/mixer は visible=true で表示 (既定 false)
            video.play();
        }
    }

    function videoTest1() {
        if (video) {
            video.stop();
            video.close();
            video = void;
        } else {
            video = new VideoOverlay(this);
            video.mode = vomMixer;
            video.open("title.mp4");
            video.visible = true;   // overlay/mixer は visible=true で表示 (既定 false)
            video.play();
        }
    }


    function videoTest() {
        if (videolay) {
            video.stop();
            video.close();
            video = false;
            invalidate videolay;
            videolay = void;
            return;
        }

        videolay = new Layer(this, primaryLayer);
        videolay.setSize(1920,1080);
        videolay.fillRect(0,0,1920,1080,0xffffffff);
        videolay.setSizeToImageSize();
        videolay.setPos(500,200);
        videolay.type = ltOpaque;
        videolay.visible = true;
        add(videolay);

        video = new VideoOverlay(this);
        video.onStatusChanged = function(status) {
            dm(@"video status change:${status}");
        } incontextof video;
        video.mode = vomLayer;
        video.layer1 = videolay;
        video.open("title.webm");
        video.play();
    }

    // ------------------------------------------------------------------
    // 動画プレイヤサンプル: 標準ファイル選択ダイアログで動画を選び全画面再生
    //   Storages.selectFile (WINVER=GetOpenFileName / SDL=SDL_ShowOpenFileDialog)
    //   ホットキー 7=開く / 8=停止 / 9=一時停止トグル
    // ------------------------------------------------------------------
    function moviePlayerOpen() {
        var params = %[
            "filter" => [
                "動画ファイル|*.mp4;*.webm;*.mpg;*.mpeg;*.wmv;*.avi;*.m4v;*.mov;*.asf",
                "すべてのファイル|*.*"
            ],
            "title" => "再生する動画ファイルを選択"
        ];
        if (Storages.selectFile(params)) {
            moviePlayerPlay(params.name);
        } else {
            dm("moviePlayer: 選択キャンセル");
        }
    }

    function moviePlayerPlay(path) {
        moviePlayerStop();
        mpVideo = new VideoOverlay(this);
        mpVideo.onStatusChanged = function(status) {
            dm(@"moviePlayer status:${status}");
        } incontextof mpVideo;
        mpVideo.mode = vomMixer;        // overlay 全画面合成 (presenter/HW 経路)
        mpVideo.open(path);
        mpVideo.visible = true;         // overlay は visible=true で表示 (既定 false)
        mpVideo.play();
        mpPaused = false;
        dm(@"moviePlayer play: ${path}");
    }

    function moviePlayerStop() {
        if (typeof(mpVideo) == "Object") {
            mpVideo.stop();
            mpVideo.close();
            mpVideo = void;
        }
        mpPaused = false;
    }

    function moviePlayerTogglePause() {
        if (typeof(mpVideo) != "Object") return;
        if (mpPaused) {
            mpVideo.play();
            mpPaused = false;
            dm("moviePlayer: 再開");
        } else {
            mpVideo.pause();
            mpPaused = true;
            dm("moviePlayer: 一時停止");
        }
    }

    // ------------------------------------------------------------------
    // 3D 音声デモ (miniaudio spatializer)
    //   リスナを画面中央 (ワールド原点、前方 = -Z) に固定し、音源を左右に
    //   フライバイさせる。左右パン + 距離減衰 + (任意で) ドップラーを実聴できる。
    //   可視化レイヤにリスナ(中央)と音源(点)を描く。
    //   座標系は miniaudio 準拠 (右手系・Y up・任意単位)。X=右, Z=手前(+)/奥(-)。
    // ------------------------------------------------------------------
    var SND3D_CX = 480, SND3D_CZ = 320; // 可視化レイヤ中心 (px)
    var SND3D_SCALE = 22;               // ワールド単位 → px

    function sound3dTest() {
        if (snd3d !== void && snd3d !== null) { sound3dStop(); return; }

        // リスナ (聴取者) を原点・前方 -Z・上 +Y に設定して有効化
        SoundListener.enabled = true;
        SoundListener.setPosition(0, 0, 0);
        SoundListener.setDirection(0, 0, -1);
        SoundListener.setWorldUp(0, 1, 0);
        SoundListener.setVelocity(0, 0, 0);

        // 3D 音源を用意 (ループ再生)
        snd3d = new WaveSoundBuffer(this);
        snd3d.use3D = true;
        snd3d.attenuationModel = snd3dModel;
        snd3d.minDistance = 2.0;    // 2 単位以内は減衰なし (最接近時に大きく)
        snd3d.maxDistance = 40.0;
        snd3d.rolloffFactor = 1.0;
        snd3d.dopplerFactor = snd3dDoppler ? 1.0 : 0.0;
        snd3dX = -15.0;
        snd3d.set3DPosition(snd3dX, 0, snd3dZ);
        snd3d.set3DVelocity(snd3dSpeed, 0, 0);
        snd3d.open(soundStorage);
        snd3d.looping = true;
        snd3d.play();

        // 可視化レイヤ
        snd3dLayer = new Layer(this, primaryLayer);
        snd3dLayer.setSize(960, 640);
        snd3dLayer.setPos(80, 120);
        snd3dLayer.type = ltOpaque;
        snd3dLayer.visible = true;
        add(snd3dLayer);
        sound3dDraw();

        // 位置更新タイマ (60fps)
        snd3dTimer = new Timer(this, "onSound3DTimer");
        snd3dTimer.interval = 1000/60;
        snd3dTimer.enabled = true;
        dm("3D sound demo started (fly-by)");
    }

    function sound3dStop() {
        if (snd3dTimer !== void && snd3dTimer !== null) {
            snd3dTimer.enabled = false;
            invalidate snd3dTimer; snd3dTimer = null;
        }
        if (snd3d !== void && snd3d !== null) {
            snd3d.stop();
            snd3d = null;
        }
        if (snd3dLayer !== void && snd3dLayer !== null) {
            invalidate snd3dLayer; snd3dLayer = null;
        }
        SoundListener.enabled = false;
        dm("3D sound demo stopped");
    }

    function onSound3DTimer() {
        if (snd3d === void || snd3d === null) return;
        var dt = (snd3dTimer.interval) / 1000.0;
        if (snd3dMode == 1) {
            // 周回モード: リスナの周りを回る (前→右→後→左)。
            // ※ miniaudio 内蔵 spatializer は HRTF 非対応で前後を区別できない
            //   (前方も後方も中央パン)。真円だと「前に来た」感が出ないため、
            //   前方で半径を小さく(=近く=大きく)・後方で大きく(=遠く=小さく)する
            //   楕円にして距離差で前後感を補う。距離はステレオでも表現できる。
            var omega = snd3dSpeed / snd3dRadius; // 角速度 (rad/s)
            snd3dAngle += omega * dt;
            if (snd3dAngle > 2*Math.PI) snd3dAngle -= 2*Math.PI;
            var a = snd3dAngle;
            // 半径: 前方(cos=1)で小さく、後方(cos=-1)で大きく
            var r = snd3dRadius - snd3dFrontBias * Math.cos(a);
            snd3dX = r * Math.sin(a);
            snd3dZ = -r * Math.cos(a); // a=0 → 前方(-Z) かつ最も近い
            snd3d.set3DPosition(snd3dX, 0, snd3dZ);
            // 接線+動径成分の速度 (r が角度依存なので動径成分も出る=前後でドップラーも付く)
            var drda = snd3dFrontBias * Math.sin(a);         // dr/da
            var vx = (drda * Math.sin(a) + r * Math.cos(a)) * omega;
            var vz = -(drda * Math.cos(a) - r * Math.sin(a)) * omega;
            snd3d.set3DVelocity(vx, 0, vz);
        } else {
            // フライバイ: X を一定速度で進め、右端を越えたら左端へ戻す
            snd3dZ = -3.0;
            snd3dX += snd3dSpeed * dt;
            var wrapped = false;
            if (snd3dX > 15.0) { snd3dX = -15.0; wrapped = true; }
            snd3d.set3DPosition(snd3dX, 0, snd3dZ);
            // ドップラー用の速度 (右方向へ移動)。折り返し時は 0 で不自然なピッチ飛びを回避
            snd3d.set3DVelocity(wrapped ? 0 : snd3dSpeed, 0, 0);
        }
        sound3dDraw();
    }

    // フライバイ ⇔ 周回 モード切替
    function sound3dToggleMode() {
        snd3dMode = (snd3dMode + 1) % 2;
        if (snd3dMode == 1) { snd3dAngle = 0.0; }
        else { snd3dX = -15.0; snd3dZ = -3.0; }
        sound3dDraw();
    }

    // 可視化: リスナ (中央) + 音源 (点) + 情報テキスト
    function sound3dDraw() {
        if (snd3dLayer === void || snd3dLayer === null) return;
        var L = snd3dLayer;
        L.font.height = 24;
        L.fillRect(0, 0, L.width, L.height, 0xff101820);
        // グリッド十字
        L.fillRect(SND3D_CX, 40, 1, L.height-80, 0xff2a3a4a);
        L.fillRect(80, SND3D_CZ, L.width-160, 1, 0xff2a3a4a);
        // リスナ (中央、前方 -Z = 画面上向き) を黄色の四角で
        L.fillRect(SND3D_CX-8, SND3D_CZ-8, 16, 16, 0xffffe000);
        L.drawText(SND3D_CX+12, SND3D_CZ-6, "Listener", 0xffe000, 255);
        // 音源位置 → px。Z は手前(+)が下、奥(-)が上になるよう素直にマップ
        var sx = SND3D_CX + (int)(snd3dX * SND3D_SCALE);
        var sz = SND3D_CZ + (int)(snd3dZ * SND3D_SCALE);
        L.fillRect(sx-10, sz-10, 20, 20, 0xff40c0ff);
        // 距離
        var dist = Math.sqrt(snd3dX*snd3dX + snd3dZ*snd3dZ);
        var pan = snd3dX < -0.5 ? "L" : (snd3dX > 0.5 ? "R" : "C");
        L.drawText(30, 30, @"3D Sound  x=${(int)(snd3dX*10)/10.0}  dist=${(int)(dist*10)/10.0}  pan=${pan}", 0xffffff, 255);
        L.drawText(30, 70, @"mode=${snd3dMode == 1 ? "orbit(周回)" : "fly-by(左右)"}  doppler=${snd3dDoppler ? "ON" : "OFF"}  model=${sound3dModelName(snd3dModel)}", 0xa0d0ff, 255);
        L.drawText(30, L.height-40, "keys: [3]開始/停止 [4]モード [5]ドップラー [6]減衰モデル", 0x80a0c0, 255);
    }

    function sound3dModelName(m) {
        switch (m) {
        case amNone:        return "none";
        case amInverse:     return "inverse";
        case amLinear:      return "linear";
        case amExponential: return "exponential";
        }
        return "?";
    }

    // ドップラー ON/OFF トグル (再生中でも即反映)
    function sound3dToggleDoppler() {
        snd3dDoppler = !snd3dDoppler;
        if (snd3d !== void && snd3d !== null)
            snd3d.dopplerFactor = snd3dDoppler ? 1.0 : 0.0;
        sound3dDraw();
    }

    // 減衰モデルを順に切り替え (none→inverse→linear→exponential→none)
    function sound3dCycleModel() {
        snd3dModel = (snd3dModel + 1) % 4;
        if (snd3d !== void && snd3d !== null)
            snd3d.attenuationModel = snd3dModel;
        sound3dDraw();
    }

    function fontText() {
        text = new Layer(this, primaryLayer);
        text.setSize(1000,100);
        text.fillRect(0,0,1000,100,0xff000000);
        text.setPos(100,600);
        text.visible = true;
        add(text);

        dm(@"フォントフェイス:${text.font.face}");
        text.font.height = 32;
        var width = text.font.getTextWidth("てすと");
        dm(@"フォントサイズの取得:${width}");
        // メニューは grabFocus=true (キー操作対象)、 パネルは grabFocus=false の
        // 常駐 HUD。 メニューが使わないキー (P 等) は passthrough でゲームに届くので、
        // メニューを開いたまま P でパネルを開ける = 複数非モーダル同時表示。
        text.drawText(10,10,"SPACE/ENTER/Start: メニュー   P: 情報パネル (メニュー開いたままでも可)", 0xffff00, 255);
    }

    function onTransitionCompleted() {
        base1 <-> base2;
    }

    function transTest(param) {
        if (base1.inTransition) {
            base1.stopTransition();
        }
        base1.beginTransition(base2, param);
    }

    // ------------------------------------------------------------------
    // ジャンル別サンプルメニュー (navigator フロー)
    // ------------------------------------------------------------------
    var menuDlg;
    // 「メニューを閉じてから起動する」サンプル (manager / DrawDevice を使うもの) の
    // 保留 id。 onContinuous がメニュー teardown 完了を待って起動する。
    var pendingSample;

    // ジャンルメニューを開く (非モーダル常駐フロー、 非ブロッキング)。
    //   - メニューは画面に出しっぱなしのまま、 背景でサンプルが動作する。
    //   - 画面遷移 (ジャンル選択 / 戻る) は JSON transitions + close_on_click が
    //     PaintOverlay 経由で駆動。 サンプル起動は close_on_click 無し button の
    //     onAction → dispatchSample。
    //   - Esc / 右クリックで一段戻る / 閉じる。 再度 SPACE で開き直せる
    //     (= 背景でサンプル動作しつつ戻ってこれる)。
    function openMenu() {
        if (menuDlg === void) menuDlg = new FlowMenuDialog(this);
        if (menuDlg.active) return;   // 既に開いている
        if (!menuDlg.startFlow("ui/menu/app.jsonc")) dm("menu: open failed");
    }

    // ------------------------------------------------------------------
    // 非モーダル情報パネル (複数同時表示デモ)。 メニューと共存する別インスタンス。
    //   VK_P でトグル。 メニューを開いたまま P を押すと、 左上のメニューと
    //   右下のパネルが同時に表示され、 それぞれ独立にクリック操作できる。
    //   startFlowScreens は modal=false (非モーダル) なので、 背景のゲームや
    //   他のパネルへ入力が素通しする。
    // ------------------------------------------------------------------
    var panelDlg;

    function panelScreenJson() {
        return @'{
            "size": [300, 170], "background": [28,40,32,235], "locale": "ja-JP",
            "align": "bottom_right", "margin": 24,
            "input": { "arrow_focus_nav": true },
            "transitions": { "close": "<exit>", "": "<exit>" },
            "content": { "type": "margin", "padding": 16, "child": {
                "type": "vtile", "children": [
                    { "type": "vsize", "height": 0, "child": { "type": "hspacer", "width": 268 } },
                    { "type": "align_center", "child": {
                        "type": "label", "text": "情報パネル (非モーダル)", "size": 1.1 } },
                    { "type": "vspacer", "height": 8 },
                    { "type": "align_center", "child": {
                        "type": "label", "text": "メニューと同時表示できます" } },
                    { "type": "vspacer", "height": 12 },
                    { "type": "htile", "children": [
                        { "type": "hsize", "width": 120, "child": {
                            "type": "button", "id": "bgm", "text": "BGM 切替" } },
                        { "type": "hspacer", "width": 8 },
                        { "type": "hsize", "width": 100, "child": {
                            "type": "button", "id": "close", "text": "閉じる",
                            "close_on_click": true, "initial_focus": true } }
                    ] } ] } }
        }';
    }

    function togglePanel() {
        if (panelDlg === void) panelDlg = new InfoPanelDialog(this);
        if (panelDlg.active) {
            panelDlg.close();
            return;
        }
        var screens = %[ "panel", panelScreenJson() ];
        // grabFocus=false: キーボードフォーカスを取らない常駐 HUD。 メニューが
        // 開いていればキーはメニューへ、 無ければゲームへ流れる (パネルは未処理
        // キーを邪魔しない)。 パネルのボタンはマウスで操作。
        if (!panelDlg.startFlowScreens(screens, "panel", false)) dm("panel: open failed");
    }

    // onAction (= サンプル button click) からの起動振り分け。
    //   即時系: メニューを残したまま背景で起動 (アニメ / サウンド / 動画 / save 等)。
    //   保留系: メニュー (= manager) を一度閉じてから起動する必要があるもの
    //           (DrawDevice 切替 / 別ダイアログ・フロー)。 pendingSample に積んで
    //           menuDlg.close()、 onContinuous が teardown 後に起動。
    function dispatchSample(action) {
        switch (action) {
        // --- 即時 (背景で動作、 メニューは残す) ---
        case "anim":   timerTest();        break;
        case "cross":  transTest(%[method:"crossfade", time:2000]); break;
        case "univ":   transTest(%[method:"universal", rule:"map07.png", time:2000]); break;
        case "bgm":    soundTest();        break;
        case "se":     seTest();           break;
        case "sound3d":   sound3dTest();          break;
        case "s3d_mode":  sound3dToggleMode();    break;
        case "s3d_dop":   sound3dToggleDoppler(); break;
        case "s3d_model": sound3dCycleModel();    break;
        case "spd_up": updateSoundSpeed(0.1);  break;
        case "spd_dn": updateSoundSpeed(-0.1); break;
        case "webm":   videoTest0();       break;
        case "mp4":    videoTest1();       break;
        case "vlayer": videoTest();        break;
        case "save":   saveTest();         break;
        case "load":   loadTest();         break;
        case "info":   sysInfo();          break;
        // 情報パネルの開閉。 メニューは開いたまま → メニュー + パネルが同時表示
        // (複数非モーダル共存)。 togglePanel は別 ElementsDialog インスタンスを使う。
        case "panel":  togglePanel();      break;
        // --- 保留 (メニューを閉じてから起動) ---
        case "ddev":
        case "dlg":
        case "modal":
        case "omodal":
        case "flow":
        case "iflow":
            pendingSample = action;
            if (menuDlg !== void) menuDlg.close();
            break;
        default:
            // ジャンル遷移 button (graphics/sound/... / back) も onAction に来るが
            // 遷移自体は transitions が担うのでここでは無視 (ログのみ)。
            dm(@"menu: (nav) ${action}");
        }
    }

    // pendingSample をメニュー teardown 完了後に起動する (onContinuous から)。
    function runDeferredSample(s) {
        switch (s) {
        case "ddev":   drawDeviceChange(); break;
        case "dlg":    dialogTest();       break;
        case "modal":  modalTest();        break;
        case "omodal": modalOverlayTest(); break;
        case "flow":   flowTest();         break;
        case "iflow":  flowInlineTest();   break;
        }
    }

    function sysInfo() {
        var msg = @"dataPath: ${System.dataPath}\nfps: ${fps}";
        dm(msg);
        System.inform(msg);
    }

    function onKeyDown(key, shift) {
        dm(@"onKeyDown:${key}:${getKeyCodeName(key)}");
        switch (key) {
        // メインの入口: スペース / Enter / ゲームパッド Start でメニューを開く
        case VK_SPACE:
        case VK_RETURN:
        case VK_PAD10:
            openMenu();
            break;
        // 非モーダル情報パネルをトグル (メニューと同時表示できることのデモ)
        case VK_P:
            togglePanel();
            break;
        // --- 直接ホットキー (メニューと同じサンプルを直接起動) ---
        case VK_X:
            drawDeviceChange();
            break;
		case VK_M:
            soundTest();
			break;
        case VK_N:
            seTest();
            break;
        case VK_UP:
            updateSoundSpeed(0.1);
            break;
        case VK_DOWN:
            updateSoundSpeed(-0.1);
            break;
		case VK_V:
            videoTest0();
			break;
        case VK_W:
            videoTest1();
			break;
		case VK_S:
            saveTest();
			break;
		case VK_L:
            loadTest();
			break;
		case VK_T:
            transTest(%[method:"crossfade", time:2000]);
			break;
		case VK_U:
            transTest(%[method:"universal", rule:"map07.png", time:2000]);
			break;
        case VK_D:
            dialogTest();
            break;
        case VK_E:
            modalTest();
            break;
        case VK_O:
            modalOverlayTest();
            break;
		case VK_I:
            timerTest();
            break;
        case VK_F:
            flowTest();
            break;
        case VK_G:
            flowInlineTest();
            break;
        case VK_K:
        case VK_PAD9:   // ゲームパッド SELECT (BACK/マイナス) でソフトキーボード
            softkeyTest();
            break;
        // --- 3D 音声デモのホットキー (メニューを開かず直接操作) ---
        case VK_3:      // 3D 音声デモ 開始/停止
            sound3dTest();
            break;
        case VK_4:      // モード切替 (左右フライバイ ⇔ 周回)
            sound3dToggleMode();
            break;
        case VK_5:      // ドップラー ON/OFF
            sound3dToggleDoppler();
            break;
        case VK_6:      // 減衰モデル切替 (none/inverse/linear/exponential)
            sound3dCycleModel();
            break;
        // --- 動画プレイヤサンプル (ファイル選択して視聴) ---
        case VK_7:      // 動画ファイルを選んで再生
            moviePlayerOpen();
            break;
        case VK_8:      // 停止
            moviePlayerStop();
            break;
        case VK_9:      // 一時停止/再開トグル
            moviePlayerTogglePause();
            break;
        }
    }

    function onKeyUp(key, shift) {
        dm(@"onKeyUp:${key}");
    }

};

var win = new MyWindow();
win.visible = true;
