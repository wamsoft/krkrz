        0x10, 'VK_SHIFT',
        0x11, 'VK_CONTROL',
        0x12, 'VK_MENU',
        0x13, 'VK_PAUSE',
        0x14, 'VK_CAPITAL',
        0x15, 'VK_KANA',
        0x17, 'VK_JUNJA',
        0x18, 'VK_FINAL',
        0x19, 'VK_HANJA',
        0x1B, 'VK_ESCAPE',
        0x1C, 'VK_CONVERT',
        0x1D, 'VK_NONCONVERT',
        0x1E, 'VK_ACCEPT',
        0x1F, 'VK_MODECHANGE',
        0x20, 'VK_SPACE',
        0x21, 'VK_PRIOR',
        0x22, 'VK_NEXT',
        0x23, 'VK_END',
        0x24, 'VK_HOME',
        0x25, 'VK_LEFT',
        0x26, 'VK_UP',
        0x27, 'VK_RIGHT',
        0x28, 'VK_DOWN',
        0x29, 'VK_SELECT',
        0x2A, 'VK_PRINT',
        0x2B, 'VK_EXECUTE',
        0x2C, 'VK_SNAPSHOT',
        0x2D, 'VK_INSERT',
        0x2E, 'VK_DELETE',
        0x2F, 'VK_HELP',
        // Numbers
        0x30, 'VK_0', 0x31, 'VK_1', 0x32, 'VK_2', 0x33, 'VK_3',
        0x34, 'VK_4', 0x35, 'VK_5', 0x36, 'VK_6', 0x37, 'VK_7',
        0x38, 'VK_8', 0x39, 'VK_9',
        // Letters
