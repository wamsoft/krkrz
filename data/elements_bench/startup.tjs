// -*- mode:tjs2 -*-
// ======================================================================
//  elements_bench — Elements overlay 負荷計測 (単体起動)
// ----------------------------------------------------------------------
//  ElementsDialog.renderStats (描画パイプラインの区間計測) で、更新パターン別の
//  シナリオ (静的 / キャレット点滅 / 毎フレーム setVar / アニメ小 /
//  アニメ広域 / 複合) を切り替えつつ renderCache の効果を数値確認する。
//  実体は scene.tjs の ElementsBenchScene。
//
//  操作: 1-6 = シナリオ / 0 = 全消去 / R = renderCache / C = 計測リセット
// ======================================================================

var demolibPath = void;
{
    // "demolib/" は datadir=data ルートから (startup.tjs の -benchauto
    // ルーティング経由で) 呼ばれた場合用。"../demolib/" は単体起動用。
    var cands = ["demolib/", "../demolib/", "../core/demolib/", "../../src/core/data/demolib/"];
    for (var i = 0; i < cands.count; i++) {
        if (Storages.isExistentStorage(cands[i] + "demo_common.tjs")) { demolibPath = cands[i]; break; }
    }
}
if (demolibPath === void) { System.inform("demolib が見つかりません"); System.exit(1); }
Scripts.execStorage(demolibPath + "demo_common.tjs");
// datadir=data ルートからの起動 (-benchauto ルーティング) では相対 "scene.tjs"
// が解決できないため、自フォルダ名付きへフォールバックする
Scripts.execStorage(Storages.isExistentStorage("scene.tjs")
                    ? "scene.tjs" : "elements_bench/scene.tjs");

runDemoShell([new ElementsBenchScene()], "Elements 負荷計測");
