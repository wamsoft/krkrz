// -*- mode:tjs2 -*-
// ======================================================================
//  text_font シーン (TextFontScene) — フォントと文字描画
// ======================================================================

class TextFontScene extends DemoScene
{
    var faceList = [];
    var sample = "あいうAgqQ 漢字 0123 ()!?";

    function TextFontScene() { super.DemoScene("フォントと文字描画"); }

    function create()
    {
        try { faceList = stage.font.getList(0); } catch (e) { faceList = []; }
        draw();
        setInfo("フォント / 文字描画の一覧");
    }

    function head(x, y, text)
    {
        resetFont();
        stage.font.height = 18;
        stage.drawText(x, y, "■ " + text, 0x8fb8e8, 255);
    }

    function draw()
    {
        var s = stage;
        s.fillRect(0, 0, 1280, 720, 0xff181c24);

        head(24, 16, "サイズ (font.height)");
        var sizes = [ 14, 20, 28, 40 ];
        var yy = 40;
        for (var i = 0; i < sizes.count; i++) {
            resetFont(); s.font.height = sizes[i];
            s.drawText(30, yy, sizes[i] + "px : " + sample, 0xe8ecf4, 255);
            yy += sizes[i] + 8;
        }

        head(24, 210, "装飾 (bold / italic / underline / strikeout)");
        resetFont(); s.font.height = 26;
        s.drawText(30, 234, "通常 Normal", 0xe8ecf4, 255);
        resetFont(); s.font.height = 26; s.font.bold = true;
        s.drawText(260, 234, "太字 Bold", 0xffd870, 255);
        resetFont(); s.font.height = 26; s.font.italic = true;
        s.drawText(470, 234, "斜体 Italic", 0x90e0ff, 255);
        resetFont(); s.font.height = 26; s.font.underline = true;
        s.drawText(700, 234, "下線 Under", 0xa0f0a0, 255);
        resetFont(); s.font.height = 26; s.font.strikeout = true;
        s.drawText(920, 234, "取消線 Strike", 0xf0a0c0, 255);
        resetFont(); s.font.height = 26; s.font.bold = true; s.font.italic = true; s.font.underline = true;
        s.drawText(30, 272, "組み合わせ Bold+Italic+Under", 0xffe0a0, 255);

        head(24, 320, "アンチエイリアス (drawText の aa 引数)");
        resetFont(); s.font.height = 40;
        s.drawText(30, 344, "aa=true 滑らか", 0xe8ecf4, 255, true);
        s.drawText(400, 344, "aa=false ギザギザ", 0xe8ecf4, 255, false);

        head(24, 410, "影 (shadow)");
        resetFont(); s.font.height = 40;
        s.drawText(30, 434, "影つき文字 Shadow", 0xffffff, 255, true, 255, 0x000000, 3, 3, 3);
        s.drawText(430, 434, "ぼかし影 Blur", 0xffe060, 255, true, 200, 0x402000, 6, 2, 2);

        head(24, 500, "文字幅計測 (getTextWidth) — 枠が実際の幅");
        resetFont(); s.font.height = 32;
        var t = "measure この文字列の幅";
        var w = s.font.getTextWidth(t);
        var h = s.font.getTextHeight(t);
        s.fillRect(30, 524, w, h, 0xff2a3550);
        s.drawText(30, 524, t, 0xffffff, 255);
        resetFont(); s.font.height = 15;
        s.drawText(30, 524 + h + 4, @"getTextWidth=${w}  getTextHeight=${h}", 0x9fb0c8, 255);

        head(660, 500, "drawText の色は 0xRRGGBB (24bit)");
        resetFont(); s.font.height = 22;
        s.drawText(666, 524, "0xffffff (正) → 白", 0xffffff, 255);
        s.drawText(666, 552, "0xffffffff (誤) → システムカラー扱い", 0xffffff, 255);
        s.fillRect(666, 580, 420, 26, 0xff30506f);
        s.drawText(672, 581, "  ← これは 0xffffffff 指定 (黒化)", 0xffffffff, 255);

        head(660, 16, @"フォント一覧 (Font.getList) — ${faceList.count} 件");
        resetFont(); s.font.height = 20;
        var shown = faceList.count < 14 ? faceList.count : 14;
        for (var i = 0; i < shown; i++) {
            resetFont();
            s.font.height = 22;
            try { s.font.face = faceList[i]; } catch (e) {}
            s.drawText(666, 42 + i * 30, faceList[i] + " : サンプル Abc 123", 0xd8e0ee, 255);
        }
        if (faceList.count == 0) {
            resetFont(); s.font.height = 20;
            s.drawText(666, 44, "(この環境ではフォント列挙が使えません)", 0xc0a0a0, 255);
        }
        s.update();
    }

    function resetFont()
    {
        var f = stage.font;
        f.face = "";
        f.bold = false; f.italic = false; f.underline = false; f.strikeout = false;
        f.angle = 0;
    }

    function onDemoTest() { dm(@"@demotest:text_font faces=${faceList.count}"); }
}


// ======================================================================
//  text_emoji シーン (TextEmojiScene) — 絵文字表示 (FreeType)
//  絵文字フォールバックは FreeType ラスタライザの機能なので、GDI 既定の
//  WINVER でも確認できるよう独立ページに分離している。
// ======================================================================
class TextEmojiScene extends DemoScene
{
    var savedRas = 0;
    var emojiFT = true;   // FreeType へ切替えられたか
    var sample = "顔 😀  星 ⭐  火 🔥  音 🎵  猫 🐱";

    function TextEmojiScene() { super.DemoScene("絵文字 (FreeType)"); }

    function create()
    {
        // Font.rasterizer はクラス(グローバル)プロパティ。絵文字は FreeType(=0)専用。
        try { savedRas = Font.rasterizer; Font.rasterizer = 0; emojiFT = true; }
        catch (e) { emojiFT = false; }
        draw();
        setInfo("font.emojiMode で 元フォント / 絵文字フォント を切替 (FreeType 専用)");
    }

    // ページを離れるときはラスタライザを元へ戻す (text_font の GDI 表示を保つ)。
    function onExit() { try { Font.rasterizer = savedRas; } catch (e) {} }

    function head(x, y, text)
    {
        resetFont(); stage.font.height = 18;
        stage.drawText(x, y, "■ " + text, 0x8fb8e8, 255);
    }

    function resetFont()
    {
        var f = stage.font;
        f.face = "";
        f.bold = false; f.italic = false; f.underline = false; f.strikeout = false;
        f.angle = 0; f.emojiMode = 0;
    }

    function row(y, mode, label)
    {
        var s = stage;
        resetFont(); s.font.height = 40; s.font.emojiMode = mode;
        s.drawText(40, y, label + ": " + sample, 0xe8ecf4, 255, true);
    }

    function draw()
    {
        var s = stage;
        s.fillRect(0, 0, 1280, 720, 0xff181c24);

        resetFont(); s.font.height = 34;
        s.drawText(40, 22, "絵文字表示 (FreeType ラスタライザ)", 0xffffff, 255, true);

        head(40, 80, "font.emojiMode : 0=元フォントのみ / 1=モノクロ絵文字 / 2=カラー絵文字");
        resetFont(); s.font.height = 18;
        s.drawText(48, 104, "・該当コードポイントを絵文字フォント (Noto Emoji) にフォールバックして描画", 0xc4ccda, 255);
        s.drawText(48, 128, "・絵文字フォントは実行ファイルに埋め込み済み。Font.emojiFaceName / Font.addFont で差替も可", 0xc4ccda, 255);
        s.drawText(48, 152, "・GDI ラスタライザ (WINVER 既定) には無い機能。この画面のみ FreeType(=0) を使用", 0xc4ccda, 255);

        if (!emojiFT) {
            resetFont(); s.font.height = 24;
            s.drawText(40, 220, "(この環境では FreeType ラスタライザが使えません)", 0xf0a0a0, 255);
            s.update();
            return;
        }

        head(40, 190, "モード比較 (同じ文字列)");
        row(214, 0, "mode0");
        row(268, 1, "mode1");
        row(322, 2, "mode2");

        resetFont(); s.font.height = 16;
        s.drawText(48, 380, "mode0 : 絵文字は元フォントに無いため tofu (□) 表示", 0x9fb0c8, 255);
        s.drawText(48, 402, "mode1 : モノクロ絵文字グリフ (Noto Emoji)", 0x9fb0c8, 255);
        s.drawText(48, 424, "mode2 : カラー絵文字グリフ (Noto Color Emoji)。★❤ 等は元フォントにもあるため mono になる場合あり", 0x9fb0c8, 255);
        s.drawText(48, 446, "  → 文字直後に VS16 (U+FE0F) を付けると その1文字だけ絵文字優先 / VS15 (U+FE0E) で原フォント強制", 0x9fb0c8, 255);

        head(40, 460, "グローバル既定: Font.defaultEmojiMode (個別 emojiMode = -1 でこれに追従)");
        resetFont(); s.font.height = 40; s.font.emojiMode = 2;
        s.drawText(48, 484, "🎨 😀 ⭐ 🔥 🎵 🐱 🎉 👍 🍎 🚀", 0xffe0a0, 255, true);

        s.update();
    }

    function onDemoTest() { dm("@demotest:text_emoji ft=" + (emojiFT ? 1 : 0)); }
}
