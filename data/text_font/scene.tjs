    "text_glyphware.h.latin"    => %[ ja : "ラテン + 日本語 (カーニング / 混植)", en : "Latin + Japanese (kerning / mixed scripts)" ],
    "text_glyphware.h.arabic"   => %[ ja : "アラビア語 (右→左 + 文字連結)", en : "Arabic (right-to-left + joining)" ],
    "text_glyphware.h.hebrew"   => %[ ja : "ヘブライ語 (右→左)", en : "Hebrew (right-to-left)" ],
    "text_glyphware.h.bidi"     => %[ ja : "双方向混在 (BiDi 自動判定, base=0)", en : "Mixed direction (BiDi auto, base=0)" ],
    "text_glyphware.h.emoji"    => %[ ja : "絵文字混在 + 装飾 (bold / underline)", en : "Mixed emoji + decoration (bold / underline)" ],
    "text_glyphware.h.measure"  => %[ ja : "計測 (measureShapedText) — 青枠=インク境界 / 赤線=ベースライン",
