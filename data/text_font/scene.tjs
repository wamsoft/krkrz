    "text_emoji.h.default"      => %[ ja : "グローバル既定: Font.defaultEmojiMode (個別 emojiMode = -1 でこれに追従)",
                                         en : "Global default: Font.defaultEmojiMode (per-font emojiMode = -1 follows it)" ],
    "text_glyphware.title"      => %[ ja : "多言語シェイピング (glyphware)", en : "Multilingual shaping (glyphware)" ],
    "text_glyphware.info"       => %[ ja : "Layer.drawShapedText — HarfBuzz シェイピング + BiDi + フォールバック連鎖 / drawShapedTextArea で矩形内折り返し",
