    "text_rasterizer.single"    => %[ ja : "(この環境では切替可能なラスタライザが 1 種のみ)", en : "(only one rasterizer available here)" ],
    "text_vertical.title"       => %[ ja : "縦組み (drawVerticalTextArea)", en : "Vertical text (drawVerticalTextArea)" ],
    "text_vertical.info"        => %[ ja : "1:ぶら下げ 2:行末揃え 3:約物の詰め 4:列送り 5:正立/横倒し ←/→:字間",
                                         en : "1:hang 2:justify 3:squeeze 4:col dir 5:orient ←/→:spacing" ],
