    "text_glyphware.heading"    => %[ ja : "多言語シェイピング描画 (Layer.drawShapedText)",
                                         en : "Multilingual shaped text (Layer.drawShapedText)" ],
    "text_glyphware.n1"         => %[ ja : "・drawText と独立した描画経路。HarfBuzz の連結/合字/カーニングと BiDi (右横書き) に対応",
