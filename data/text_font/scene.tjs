// -*- mode:tjs2 -*-
// ======================================================================
//  text_font シーン (TextFontScene) — フォントと文字描画
// ======================================================================

class TextFontScene extends DemoScene
{
    var faceList = [];
    var sample = "あいうAgqQ 漢字 0123 ()!?";

    function TextFontScene() { super.DemoScene("フォントと文字描画"); }

    function create()
    {
        try { faceList = stage.font.getList(0); } catch (e) { faceList = []; }
        draw();
        setInfo("フォント / 文字描画の一覧");
    }

    function head(x, y, text)
    {
        resetFont();
        stage.font.height = 18;
        stage.drawText(x, y, "■ " + text, 0x8fb8e8, 255);
    }

    function draw()
    {
        var s = stage;
        s.fillRect(0, 0, 1280, 720, 0xff181c24);

        head(24, 16, "サイズ (font.height)");
        var sizes = [ 14, 20, 28, 40 ];
        var yy = 40;
        for (var i = 0; i < sizes.count; i++) {
            resetFont(); s.font.height = sizes[i];
            s.drawText(30, yy, sizes[i] + "px : " + sample, 0xe8ecf4, 255);
            yy += sizes[i] + 8;
        }

        head(24, 210, "装飾 (bold / italic / underline / strikeout)");
        resetFont(); s.font.height = 26;
        s.drawText(30, 234, "通常 Normal", 0xe8ecf4, 255);
        resetFont(); s.font.height = 26; s.font.bold = true;
        s.drawText(260, 234, "太字 Bold", 0xffd870, 255);
        resetFont(); s.font.height = 26; s.font.italic = true;
        s.drawText(470, 234, "斜体 Italic", 0x90e0ff, 255);
        resetFont(); s.font.height = 26; s.font.underline = true;
        s.drawText(700, 234, "下線 Under", 0xa0f0a0, 255);
        resetFont(); s.font.height = 26; s.font.strikeout = true;
        s.drawText(920, 234, "取消線 Strike", 0xf0a0c0, 255);
        resetFont(); s.font.height = 26; s.font.bold = true; s.font.italic = true; s.font.underline = true;
        s.drawText(30, 272, "組み合わせ Bold+Italic+Under", 0xffe0a0, 255);

        head(24, 320, "アンチエイリアス (drawText の aa 引数)");
        resetFont(); s.font.height = 40;
        s.drawText(30, 344, "aa=true 滑らか", 0xe8ecf4, 255, true);
        s.drawText(400, 344, "aa=false ギザギザ", 0xe8ecf4, 255, false);

        head(24, 410, "影 (shadow)");
        resetFont(); s.font.height = 40;
        s.drawText(30, 434, "影つき文字 Shadow", 0xffffff, 255, true, 255, 0x000000, 3, 3, 3);
        s.drawText(430, 434, "ぼかし影 Blur", 0xffe060, 255, true, 200, 0x402000, 6, 2, 2);

        head(24, 500, "文字幅計測 (getTextWidth) — 枠が実際の幅");
        resetFont(); s.font.height = 32;
        var t = "measure この文字列の幅";
        var w = s.font.getTextWidth(t);
        var h = s.font.getTextHeight(t);
        s.fillRect(30, 524, w, h, 0xff2a3550);
        s.drawText(30, 524, t, 0xffffff, 255);
        resetFont(); s.font.height = 15;
        s.drawText(30, 524 + h + 4, @"getTextWidth=${w}  getTextHeight=${h}", 0x9fb0c8, 255);

        head(660, 500, "drawText の色は 0xRRGGBB (24bit)");
        resetFont(); s.font.height = 22;
        s.drawText(666, 524, "0xffffff (正) → 白", 0xffffff, 255);
        s.drawText(666, 552, "0xffffffff (誤) → システムカラー扱い", 0xffffff, 255);
        s.fillRect(666, 580, 420, 26, 0xff30506f);
        s.drawText(672, 581, "  ← これは 0xffffffff 指定 (黒化)", 0xffffffff, 255);

        head(660, 16, @"フォント一覧 (Font.getList) — ${faceList.count} 件");
        var shown = faceList.count < 14 ? faceList.count : 14;
        for (var i = 0; i < shown; i++) {
            // フォント名は既定フェイスで描く (アイコンフォントや絵文字フォント
            // だと名前自体が読めなくなるため)。サンプル部分のみ対象フェイス。
            resetFont();
            s.font.height = 20;
            var label = faceList[i] + " : ";
            s.drawText(666, 44 + i * 30, label, 0xd8e0ee, 255);
            var lw = s.font.getTextWidth(label);
            s.font.height = 22;
            try { s.font.face = faceList[i]; } catch (e) {}
            s.drawText(666 + lw, 42 + i * 30, "サンプル Abc 123", 0xd8e0ee, 255);
        }
        if (faceList.count == 0) {
            resetFont(); s.font.height = 20;
            s.drawText(666, 44, "(この環境ではフォント列挙が使えません)", 0xc0a0a0, 255);
        }
        s.update();
    }

    function resetFont()
    {
        var f = stage.font;
        f.face = "";
        f.bold = false; f.italic = false; f.underline = false; f.strikeout = false;
        f.angle = 0;
    }

    function onDemoTest() { dm(@"@demotest:text_font faces=${faceList.count}"); }
}


// ======================================================================
//  text_emoji シーン (TextEmojiScene) — 絵文字表示 (FreeType)
//  絵文字フォールバックは FreeType ラスタライザの機能なので、GDI 既定の
//  WINVER でも確認できるよう独立ページに分離している。
// ======================================================================
class TextEmojiScene extends DemoScene
{
    var savedRas = 0;
    var emojiFT = true;   // FreeType へ切替えられたか
    var sample = "顔 😀  星 ⭐  火 🔥  音 🎵  猫 🐱";

    function TextEmojiScene() { super.DemoScene("絵文字 (FreeType)"); }

    function create()
    {
        // Font.rasterizer はクラス(グローバル)プロパティ。絵文字は FreeType(=0)専用。
        try { savedRas = Font.rasterizer; Font.rasterizer = 0; emojiFT = true; }
        catch (e) { emojiFT = false; }
        draw();
        setInfo("font.emojiMode で 元フォント / 絵文字フォント を切替 (FreeType 専用)");
    }

    // ページを離れるときはラスタライザを元へ戻す (text_font の GDI 表示を保つ)。
    function onExit() { try { Font.rasterizer = savedRas; } catch (e) {} }

    function head(x, y, text)
    {
        resetFont(); stage.font.height = 18;
        stage.drawText(x, y, "■ " + text, 0x8fb8e8, 255);
    }

    function resetFont()
    {
        var f = stage.font;
        f.face = "";
        f.bold = false; f.italic = false; f.underline = false; f.strikeout = false;
        f.angle = 0; f.emojiMode = 0;
    }

    function row(y, mode, label)
    {
        var s = stage;
        resetFont(); s.font.height = 40; s.font.emojiMode = mode;
        s.drawText(40, y, label + ": " + sample, 0xe8ecf4, 255, true);
    }

    function draw()
    {
        var s = stage;
        s.fillRect(0, 0, 1280, 720, 0xff181c24);

        resetFont(); s.font.height = 34;
        s.drawText(40, 22, "絵文字表示 (FreeType ラスタライザ)", 0xffffff, 255, true);

        head(40, 80, "font.emojiMode : 0=元フォントのみ / 1=モノクロ絵文字 / 2=カラー絵文字");
        resetFont(); s.font.height = 18;
        s.drawText(48, 104, "・該当コードポイントを絵文字フォント (Noto Emoji) にフォールバックして描画", 0xc4ccda, 255);
        s.drawText(48, 128, "・絵文字フォントは実行ファイルに埋め込み済み。Font.emojiFaceName / Font.addFont で差替も可", 0xc4ccda, 255);
        s.drawText(48, 152, "・GDI ラスタライザ (WINVER 既定) には無い機能。この画面のみ FreeType(=0) を使用", 0xc4ccda, 255);

        if (!emojiFT) {
            resetFont(); s.font.height = 24;
            s.drawText(40, 220, "(この環境では FreeType ラスタライザが使えません)", 0xf0a0a0, 255);
            s.update();
            return;
        }

        head(40, 190, "モード比較 (同じ文字列)");
        row(214, 0, "mode0");
        row(268, 1, "mode1");
        row(322, 2, "mode2");

        resetFont(); s.font.height = 16;
        s.drawText(48, 380, "mode0 : 絵文字は元フォントに無いため tofu (□) 表示", 0x9fb0c8, 255);
        s.drawText(48, 402, "mode1 : モノクロ絵文字グリフ (Noto Emoji)", 0x9fb0c8, 255);
        s.drawText(48, 424, "mode2 : カラー絵文字グリフ (Noto Color Emoji)。★❤ 等は元フォントにもあるため mono になる場合あり", 0x9fb0c8, 255);
        s.drawText(48, 446, "  → 文字直後に VS16 (U+FE0F) を付けると その1文字だけ絵文字優先 / VS15 (U+FE0E) で原フォント強制", 0x9fb0c8, 255);

        head(40, 460, "グローバル既定: Font.defaultEmojiMode (個別 emojiMode = -1 でこれに追従)");
        resetFont(); s.font.height = 40; s.font.emojiMode = 2;
        s.drawText(48, 484, "🎨 😀 ⭐ 🔥 🎵 🐱 🎉 👍 🍎 🚀", 0xffe0a0, 255, true);

        s.update();
    }

    function onDemoTest() { dm("@demotest:text_emoji ft=" + (emojiFT ? 1 : 0)); }
}


// ======================================================================
//  text_glyphware シーン (TextGlyphwareScene) — 多言語シェイピング描画
//  Layer.drawShapedText: drawText と独立した glyphware 描画経路。
//  HarfBuzz シェイピング (連結/合字/カーニング) + BiDi (右横書き) +
//  フォールバック連鎖に対応する。drawShapedTextArea で矩形内折り返し、
//  count 指定でタイプライタ表示 (クラスタ単位) もできる。アラビア語/
//  ヘブライ語の字形はシステムフォント (Segoe UI 等) を名前解決で使う
//  (WINVER)。見つからない環境では代替表示になる旨を注記する。
// ======================================================================
class TextGlyphwareScene extends DemoScene
{
    var rtlFont = "";   // RTL (アラビア/ヘブライ) を収録するフォント名
    var chain = "";     // フォールバック連鎖 (fontKey)

    // タイプライタ (count 制限) アニメ状態 — onDemoFrame で 1 クラスタずつ進める
    var twText = "", twFont;
    var twTotal = 0, twCount = 0, twNextTick = 0;
    var twX = 0, twY = 0, twW = 0, twH = 0;

    function TextGlyphwareScene() { super.DemoScene("多言語シェイピング (glyphware)"); }

    function create()
    {
        // RTL (アラビア/ヘブライ) 用フォント: fonts.json 宣言の Noto を優先し
        // (SDL 版含む全プラットフォームで同一表示)、無ければシステムフォント
        // (Windows) へフォールバック (Font.getFontInfo は解決不能名に void)
        var cand = ["Noto Sans Arabic", "Segoe UI", "Arial", "Tahoma"];
        for (var i = 0; i < cand.count; i++) {
            if (typeof global.Layer.drawShapedText == "undefined") break;
            if (Font.getFontInfo(cand[i]) !== void) { rtlFont = cand[i]; break; }
        }
        chain = "Noto Sans JP Regular";              // 埋め込み日本語 (基本)
        if (rtlFont == "Noto Sans Arabic") {
            chain += ",Noto Sans Arabic,Noto Sans Hebrew";   // data/fonts + fonts.json 宣言
        } else if (rtlFont != "") {
            chain += "," + rtlFont;                  // RTL 収録のシステムフォント
        }
        // 絵文字: カラー (fonts.json 宣言、単体起動などで無ければ解決されず
        // スキップ) → 埋め込みモノクロ (常に有効) の順でフォールバック
        // (リソースの置き場は System.resourcePath で吸収。直書きすると wasm で外れる)
        chain += ",Noto Color Emoji," + System.resourcePath + "notoemoji-regular.ttf";
        draw();
        setInfo("Layer.drawShapedText — HarfBuzz シェイピング + BiDi + フォールバック連鎖 / drawShapedTextArea で矩形内折り返し");
    }

    function head(x, y, text)
    {
        var f = stage.font;
        f.face = ""; f.bold = false; f.underline = false; f.emojiMode = 0;
        f.height = 18;
        stage.drawText(x, y, "■ " + text, 0x8fb8e8, 255);
    }

    function draw()
    {
        var s = stage;
        s.fillRect(0, 0, 1280, 720, 0xff181c24);

        if (typeof global.Layer.drawShapedText == "undefined") {
            s.font.face = ""; s.font.height = 24;
            s.drawText(40, 40, "この環境では drawShapedText が使えません (glyphware 無効ビルド)", 0xf0a0a0, 255);
            s.update();
            return;
        }

        s.font.face = ""; s.font.height = 34;
        s.drawText(40, 22, "多言語シェイピング描画 (Layer.drawShapedText)", 0xffffff, 255, true);
        s.font.height = 18;
        s.drawText(48, 66, "・drawText と独立した描画経路。HarfBuzz の連結/合字/カーニングと BiDi (右横書き) に対応", 0xc4ccda, 255);
        s.drawText(48, 90, "・font は Font オブジェクト指定。face のカンマ区切りでフォールバック連鎖 (JP+RTL+絵文字)", 0xc4ccda, 255);

        // 描画属性は Font オブジェクト 1 個にまとめて渡す (レイヤ font とは独立)
        var f = new Font();
        f.face = chain; f.height = 40;

        var y = 176;
        head(40, y - 26, "ラテン + 日本語 (カーニング / 混植)");
        s.drawShapedText(48, y + 34, "AVATAR Type 東京 To Word", 0xe8ecf4, f);

        y = 266;
        head(40, y - 26, "アラビア語 (右→左 + 文字連結)");
        s.drawShapedText(48, y + 34, "مرحبا بالعالم — السلام عليكم", 0xe8ecf4, f);

        y = 356;
        head(40, y - 26, "ヘブライ語 (右→左)");
        s.drawShapedText(48, y + 34, "שלום עולם", 0xe8ecf4, f);

        y = 446;
        head(40, y - 26, "双方向混在 (BiDi 自動判定, base=0)");
        s.drawShapedText(48, y + 34, "Total מספר 123 עמודים OK", 0xe8ecf4, f);

        y = 536;
        head(40, y - 26, "絵文字混在 + 装飾 (bold / underline)");
        f.bold = true; f.underline = true;
        s.drawShapedText(48, y + 34, "日本語 English 😀🔥⭐ まとめて1行", 0xffe0a0, f);
        f.bold = false; f.underline = false;

        // 計測: インク境界の枠とベースラインを描いてから同じ条件で描画する
        y = 622;
        head(40, y - 26, "計測 (measureShapedText) — 青枠=インク境界 / 赤線=ベースライン");
        var text = "Meas 計測 مرحبا";
        var bx = 48, by = y + 34;
        f.height = 36;
        var m = s.measureShapedText(text, f);
        if (m !== void) {
            s.fillRect(bx + m.left, by + m.top, m.right - m.left, m.bottom - m.top, 0xff2a3a55);
            s.fillRect(bx - 8, by, m.width + 16, 1, 0xffff8080);
        }
        s.drawShapedText(bx, by, text, 0xe8ecf4, f);

        // 右側: 矩形内折り返し (drawShapedTextArea) + count 制限 (タイプライタ)
        var para = "吉里吉里Zの統一フォントエンジンによる簡易折り返し描画。"
                 + "日本語は文字単位、English words wrap at spaces、"
                 + "行頭禁則(、。等)にも対応します。\n"
                 + "明示改行もOK。絵文字😀も1文字扱いです。";
        var ax = 780, ay = 176, aw = 440, ah = 216;
        head(ax - 8, ay - 34, "矩形内折り返し (drawShapedTextArea)");
        s.fillRect(ax - 8, ay - 8, aw + 16, ah + 16, 0xff20283a);
        f.height = 24;
        var r = s.drawShapedTextArea(ax, ay, aw, ah, para, 0xe8ecf4, f);
        s.font.face = ""; s.font.height = 16;
        if (r !== void)
            s.drawText(ax - 8, ay + ah + 14, "結果: lines=" + r.lines + " height=" + r.height + " count=" + r.count, 0x8fb8e8, 255);

        // タイプライタ (count 制限): RTL 混在文を 1 クラスタずつ全文表示→繰り返し。
        // 進行は onDemoFrame。RTL 区間は論理順 (読み順) で現れるため、
        // 表示が右から左へ伸びていく様子が観察できる。
        twText = "Typewriter: 日本語と English に أهلا وسهلا アラビア語、"
               + "שלום עולם ヘブライ語を混在。\n"
               + "RTL 区間は論理順 (読み順) で 1 クラスタずつ現れ、"
               + "表示は右から左へ伸びます😀";
        twFont = new Font();
        twFont.face = chain; twFont.height = 22;
        twX = ax; twY = ay + ah + 84; twW = aw; twH = 150;
        head(ax - 8, twY - 34, "count 制限 = タイプライタ (RTL 混在, 自動再生)");
        twTotal = s.shapedTextCount(twText, twFont);
        twCount = 0; twNextTick = 0;
        drawTypewriter();

        if (rtlFont == "") {
            s.font.face = ""; s.font.height = 16;
            s.drawText(560, 66, "(RTL 収録フォント未検出のためアラビア語/ヘブライ語は代替字形)", 0xf0a0a0, 255);
        }
        s.update();
    }

    // タイプライタ枠 + 現在の count を描画する
    function drawTypewriter()
    {
        var s = stage;
        s.fillRect(twX - 8, twY - 8, twW + 16, twH + 16, 0xff20283a);
        s.drawShapedTextArea(twX, twY, twW, twH, twText, 0xffe0a0, twFont, 0, twCount);
        // クリアはセル高より広めに取る (実グリフはセル高 16px を数 px はみ出す)
        s.fillRect(twX - 8, twY + twH + 8, twW + 16, 28, 0xff181c24);
        s.font.face = ""; s.font.height = 16; s.font.bold = false;
        s.drawText(twX - 8, twY + twH + 12, "count = " + twCount + " / " + twTotal, 0x8fb8e8, 255);
    }

    function onDemoFrame(tick)
    {
        if (twTotal <= 0) return;             // glyphware 無効ビルド等
        if (tick < twNextTick) return;
        if (twCount >= twTotal) {
            twCount = 0;                      // 全文表示後は空に戻して繰り返し
            twNextTick = tick + 500;
        } else {
            twCount++;
            twNextTick = tick + (twCount >= twTotal ? 1500 : 60);
        }
        drawTypewriter();
    }

    function onDemoTest() { dm("@demotest:text_glyphware rtl=" + (rtlFont != "" ? rtlFont : "none") + " tw=" + twCount + "/" + twTotal); }
}


// ======================================================================
//  text_rasterizer シーン (TextRasterizerScene) — ラスタライザ比較
//  同一内容を FreeType / GDI / glyphware で描画し、←/→/Space で切り替えて
//  目視比較する。Font.rasterizer はクラス(グローバル)プロパティ。列挙は
//  ビルドにより異なる:
//    WINVER : 0=FreeType, 1=GDI, 2=glyphware
//    SDL等  : 0=FreeType, 1=glyphware
//  (未実装スロットは Font.rasterizer=i の書き戻しが効かないことで検出する)
// ======================================================================
class TextRasterizerScene extends DemoScene
{
    var savedRas = 0;
    var rasters = [];    // [ %[ index, name ], ... ] 利用可能なラスタライザ
    var cur = 0;         // rasters[] のインデックス
    var sample = "あいうAgqQ 漢字 0123 ()!? — Text テキスト";

    function TextRasterizerScene() { super.DemoScene("ラスタライザ比較"); }

    function create()
    {
        try { savedRas = Font.rasterizer; } catch (e) { savedRas = 0; }
        rasters = detectRasterizers();
        cur = 0;
        for (var i = 0; i < rasters.count; i++)
            if (rasters[i].index == savedRas) { cur = i; break; }
        applyAndDraw();
        setInfo("←/→ or Space: ラスタライザ切替   同じ内容を各ラスタライザで描画して比較");
    }

    // 離脱時は元のラスタライザへ戻す (他シーンの表示を保つ)
    function onExit() { try { Font.rasterizer = savedRas; } catch (e) {} }

    // 利用可能なラスタライザを列挙 (set + 書き戻し確認で検出)。
    function detectRasterizers()
    {
        var win = false;
        try { win = (("" + System.buildVariantName) == "WIN"); } catch (e) {}
        var list = [];
        for (var idx = 0; idx <= 2; idx++) {
            var ok = false;
            try { Font.rasterizer = idx; ok = (Font.rasterizer == idx); } catch (e) { ok = false; }
            if (!ok) continue;
            var nm;
            if (idx == 0) nm = "FreeType";
            else if (win && (idx == 1)) nm = "GDI (Windows)";
            else if (win && (idx == 2)) nm = "glyphware";
            else if (!win && (idx == 1)) nm = "glyphware";
            else nm = "rasterizer " + idx;
            list.add(%[ index : idx, name : nm ]);
        }
        try { Font.rasterizer = savedRas; } catch (e) {}
        if (list.count == 0) list.add(%[ index : 0, name : "FreeType" ]);
        return list;
    }

    function applyAndDraw()
    {
        try { Font.rasterizer = rasters[cur].index; } catch (e) {}
        draw();
    }

    function cycle(d)
    {
        if (rasters.count <= 1) return;
        cur = (cur + d + rasters.count) % rasters.count;
        applyAndDraw();
    }

    function onKeyDown(key, shift)
    {
        switch (key) {
        case VK_LEFT:  cycle(-1); break;
        case VK_RIGHT: cycle(1);  break;
        case VK_SPACE: cycle(1);  break;
        }
    }

    function onMouseDown(x, y, button, shift)
    {
        // 上部のセレクタ チップをクリックで選択
        if (y >= 56 && y < 88) {
            for (var i = 0; i < rasters.count; i++) {
                if (x >= _chipX[i] && x < _chipX[i] + _chipW[i]) { cur = i; applyAndDraw(); return; }
            }
        }
    }

    var _chipX = [], _chipW = [];

    function head(x, y, text)
    {
        resetFont(); stage.font.height = 18;
        stage.drawText(x, y, "■ " + text, 0x8fb8e8, 255);
    }

    function resetFont()
    {
        var f = stage.font;
        f.face = ""; f.bold = false; f.italic = false; f.underline = false;
        f.strikeout = false; f.angle = 0; f.emojiMode = 0;
    }

    function draw()
    {
        var s = stage;
        s.fillRect(0, 0, 1280, 720, 0xff181c24);

        // 見出し + 現在のラスタライザ
        resetFont(); s.font.height = 30;
        var pre = "ラスタライザ比較 — 現在: ";
        s.drawText(24, 16, pre, 0xffffff, 255, true);
        var hx = 24 + s.font.getTextWidth(pre);
        resetFont(); s.font.height = 30; s.font.bold = true;
        s.drawText(hx, 16, rasters[cur].name + " (index " + rasters[cur].index + ")", 0xffe060, 255, true);

        // セレクタ チップ (クリック/←→ で切替)
        resetFont(); s.font.height = 20;
        _chipX = []; _chipW = [];
        var cx = 24;
        for (var i = 0; i < rasters.count; i++) {
            var lbl = rasters[i].name;
            var w = s.font.getTextWidth(lbl) + 24;
            var sel = (i == cur);
            s.fillRect(cx, 56, w, 30, sel ? 0xff2d6a4f : 0xff232a36);
            if (sel) s.fillRect(cx, 56, w, 3, 0xff70e0a0);
            resetFont(); s.font.height = 20;
            s.drawText(cx + 12, 60, lbl, sel ? 0xffffff : 0xa0aec0, 255);
            _chipX.add(cx); _chipW.add(w);
            cx += w + 10;
        }

        // --- 左列: サイズ / 装飾 / 影 / 回転 ---
        // 右列 (x=680〜) と重ならないよう、左列の描画は x<660 に収める。
        // 大サイズ行はサンプル文字列を短縮する (42px でフル文だと右列に食い込む)。
        head(24, 100, "サイズ (CJK + Latin 混在)");
        var sizes = [ 16, 22, 30, 42 ];
        var sizeSamples = [ sample, sample,
                            "あいうAgqQ 漢字 0123 Text", "あいうAgqQ 漢字 Text" ];
        var yy = 124;
        for (var i = 0; i < sizes.count; i++) {
            resetFont(); s.font.height = sizes[i];
            s.drawText(30, yy, sizes[i] + "px : " + sizeSamples[i], 0xe8ecf4, 255, true);
            yy += sizes[i] + 8;
        }

        // 装飾は 2 行に分けて左列内 (x<660) に収める
        head(24, 300, "装飾 (bold / italic / underline / strikeout)");
        resetFont(); s.font.height = 26; s.drawText(30, 324, "通常 Normal", 0xe8ecf4, 255, true);
        resetFont(); s.font.height = 26; s.font.bold = true; s.drawText(230, 324, "太字 Bold", 0xffd870, 255, true);
        resetFont(); s.font.height = 26; s.font.italic = true; s.drawText(430, 324, "斜体 Italic", 0x90e0ff, 255, true);
        resetFont(); s.font.height = 26; s.font.underline = true; s.drawText(30, 356, "下線 Under", 0xa0f0a0, 255, true);
        resetFont(); s.font.height = 26; s.font.strikeout = true; s.drawText(230, 356, "取消 Strike", 0xf0a0c0, 255, true);

        head(24, 398, "影 / ぼかし影 (shadow)");
        resetFont(); s.font.height = 36;
        s.drawText(30, 422, "影つき Shadow", 0xffffff, 255, true, 255, 0x000000, 3, 3, 3);
        s.drawText(320, 422, "ぼかし Blur", 0xffe060, 255, true, 200, 0x402000, 6, 2, 2);

        // 見出しは短く (長文だと回転テキストの軌跡と交差する)。回転テキストは
        // (240,640) から右上へ = 影セクションや注記と交差しない軌跡にする。
        head(24, 474, "回転 (font.angle=300)");
        resetFont(); s.font.height = 30; s.font.angle = 300;
        s.drawText(240, 640, "angle 回転 ABC 日本語", 0x90e0ff, 255, true);
        resetFont(); s.font.height = 15;
        s.drawText(30, 500, "GDI はグリフ回転 /", 0x9fb0c8, 255);
        s.drawText(30, 520, "FreeType・glyphware は送りのみ回転", 0x9fb0c8, 255);
        resetFont();

        // --- 右列: 絵文字 / 計測 ---
        head(680, 100, "絵文字 (font.emojiMode=2 カラー)");
        resetFont(); s.font.height = 36; s.font.emojiMode = 2;
        s.drawText(686, 124, "😀 ⭐ 🔥 🍣 🎌 🚀", 0xffffff, 255, true);
        resetFont(); s.font.height = 15;
        s.drawText(686, 172, "FreeType / glyphware = カラー絵文字", 0x9fb0c8, 255);
        s.drawText(686, 192, "GDI = 絵文字フォールバック非対応 (□/白抜き)", 0x9fb0c8, 255);

        head(680, 226, "文字幅計測 (getTextWidth) — 枠が実幅");
        resetFont(); s.font.height = 30;
        var t = "measure この文字列の幅";
        var w = s.font.getTextWidth(t);
        var h = s.font.getTextHeight(t);
        s.fillRect(686, 250, w, h, 0xff2a3550);
        s.drawText(686, 250, t, 0xffffff, 255, true);
        resetFont(); s.font.height = 15;
        s.drawText(686, 250 + h + 4, @"getTextWidth=${w}  getTextHeight=${h}", 0x9fb0c8, 255);

        head(680, 330, "備考");
        resetFont(); s.font.height = 16;
        s.drawText(686, 354, "・同じ TJS コード (drawText) で描画。ラスタライザだけ切替", 0xc4ccda, 255);
        s.drawText(686, 376, "・glyphware = FreeType + HarfBuzz の統一フォントエンジン", 0xc4ccda, 255);
        s.drawText(686, 398, "・GDI = WINVER 既定。glyphware は Font.rasterizer で opt-in", 0xc4ccda, 255);
        s.drawText(686, 420, "・既定挙動は不変 (既存ゲーム互換)。切替時のみ経路が変わる", 0xc4ccda, 255);
        if (rasters.count <= 1) {
            resetFont(); s.font.height = 18;
            s.drawText(686, 452, "(この環境では切替可能なラスタライザが 1 種のみ)", 0xf0c090, 255);
        }

        s.update();
    }

    function onDemoTest()
    {
        var names = "";
        for (var i = 0; i < rasters.count; i++) names += (i ? "," : "") + rasters[i].name;
        dm(@"@demotest:text_rasterizer count=${rasters.count} avail=${names}");
    }
}


// ======================================================================
//  text_vertical シーン (TextVerticalScene) — 縦組み (日本語縦書き)
//  Layer.drawVerticalTextArea: 横組み (drawShapedTextArea) とは別経路の
//  縦書き描画。和文は正立・欧文は横倒しに組み分け、約物の詰め・行頭行末
//  禁則・追い込み/追い出し・ぶら下げを日本語組版規則 (JLReq) のアキ量で
//  処理する。第 10 引数の options 辞書をキー操作で切り替えて差を目視する。
//  未対応: ルビ・縦中横・圏点・割注・字取り、段組、下線/打ち消し線、angle。
// ======================================================================
class TextVerticalScene extends DemoScene
{
    var chain = "";      // フォールバック連鎖 (Font.face)
    var body = "";       // 流し込む本文

    // options 辞書の内容 (キー操作で切り替える)
    var ori = 0;                 // orientation: 0=和文正立/欧文横倒し 1=全正立 2=全横倒し
    var hanging = false;         // 行末の句読点を版面外へ出す
    var justify = true;          // 行末を揃える
    var punctuation = true;      // 約物の詰め (偽ならベタ組み)
    var vlr = false;             // 列送り: 偽=右から左 / 真=左から右
    var lsList = [ 0.0, 0.05, 0.1, 0.25 ], lsIdx = 0;   // letterSpacing (em)

    // タイプライタ (count 制限) アニメ状態 — onDemoFrame で 1 クラスタずつ進める
    var twText = "", twFont;
    var twTotal = 0, twCount = 0, twNextTick = 0;
    var twX = 0, twY = 0, twW = 0, twH = 0;

    function TextVerticalScene() { super.DemoScene("縦組み (drawVerticalTextArea)"); }

    function create()
    {
        // 埋め込み日本語フォント。縦字形 (vert/vrt2) と縦アドバンス (vmtx) を
        // 持つので、括弧や長音符が縦向きの字形になる
        chain = "Noto Sans JP Regular";
        body = "縦組みは、和文を正立させ、欧文や数字を横倒しにして組みます。"
             + "行頭に句読点や閉じ括弧が来ないよう禁則処理を行い、"
             + "「約物」の詰めや和欧間のアキも日本語組版規則に従います。\n"
             + "改行は段落の区切りです。追い込み・追い出し・行末揃えは、"
             + "行ごとのアキの伸縮 1 つで表現されます。Kirikiri Z 2.2 の"
             + "ような英数字は横倒しのままで、縦中横にはなりません。";
        twText = "count 指定で縦組みもタイプライタ表示になります。\n"
               + "行分割は全文で確定してから制限を掛けるので、"
               + "途中で列が組み替わりません。";
        twFont = new Font();
        twFont.face = chain; twFont.height = 20;
        draw();
        setInfo("1:ぶら下げ 2:行末揃え 3:約物の詰め 4:列送り 5:正立/横倒し ←/→:字間");
    }

    // 現在の設定を options 辞書 (drawVerticalTextArea の第 10 引数) にする
    function currentOptions()
    {
        return %[ "orientation"   => ori,
                  "verticalLr"    => vlr,
                  "punctuation"   => punctuation,
                  "hanging"       => hanging,
                  "justify"       => justify,
                  "letterSpacing" => lsList[lsIdx] ];
    }

    function oriName(v)
    {
        if (v == 1) return "1=全て正立";
        if (v == 2) return "2=全て横倒し";
        return "0=和文正立/欧文横倒し";
    }

    function optionsLabel()
    {
        return "orientation " + oriName(ori)
             + " / verticalLr " + (vlr ? "true (左→右)" : "false (右→左)")
             + " / punctuation " + (punctuation ? "true" : "false")
             + " / hanging " + (hanging ? "true" : "false")
             + " / justify " + (justify ? "true" : "false")
             + " / letterSpacing " + "%.2f".sprintf(lsList[lsIdx]);
    }

    function head(x, y, text)
    {
        resetFont(); stage.font.height = 18;
        stage.drawText(x, y, "■ " + text, 0x8fb8e8, 255);
    }

    function resetFont()
    {
        var f = stage.font;
        f.face = ""; f.bold = false; f.italic = false; f.underline = false;
        f.strikeout = false; f.angle = 0; f.emojiMode = 0;
    }

    function draw()
    {
        var s = stage;
        s.fillRect(0, 0, 1280, 720, 0xff181c24);

        if (typeof global.Layer.drawVerticalTextArea == "undefined") {
            resetFont(); s.font.height = 24;
            s.drawText(40, 40, "この環境では drawVerticalTextArea が使えません (glyphware 無効ビルド)", 0xf0a0a0, 255);
            s.update();
            return;
        }

        resetFont();
        s.font.height = 34;
        s.drawText(40, 22, "縦組み描画 (Layer.drawVerticalTextArea)", 0xffffff, 255, true);
        s.font.height = 18;
        s.drawText(48, 64, "・和文は正立 / 欧文・数字は横倒し。約物の詰め・行頭行末禁則・追い込み/追い出しを JLReq のアキ量で処理", 0xc4ccda, 255);
        s.drawText(48, 88, "・未対応: ルビ / 縦中横 / 圏点 / 割注 / 字取り / 段組 / 下線・打ち消し線 / Font.angle", 0xc4ccda, 255);
        s.font.height = 16;
        s.drawText(48, 114, "options = " + optionsLabel(), 0x8fb8e8, 255);

        var o = currentOptions();
        var f = new Font();
        f.face = chain; f.height = 20;

        // ---- 本文の流し込み (縦組み) ---------------------------------
        var bx = 48, by = 178, bw = 264, bh = 460;
        head(bx - 8, by - 34, "縦組み — 列は右から左へ");
        s.fillRect(bx - 8, by - 8, bw + 16, bh + 16, 0xff20283a);
        var r = s.drawVerticalTextArea(bx, by, bw, bh, body, 0xe8ecf4, f, -1, 6, o);
        resetFont(); s.font.height = 16;
        if (r !== void)
            s.drawText(bx - 8, by + bh + 14,
                       "lines=" + r.lines + " width=" + r.width
                       + " count=" + r.count + "/" + r.totalCount, 0x8fb8e8, 255);

        // ---- 同じ本文を横組みで (対比) -------------------------------
        // 折り返しも禁則も別実装 (drawShapedTextArea) なので、同じ本文でも
        // 行の切れ方・約物の詰まり方が違う。count の数え方も別 (縦組みは
        // 描画される文字だけを数え、欧文の単語間空白は数えない)
        var hx = 356, hy = 178, hw = 292, hh = 460;
        head(hx - 8, hy - 34, "同じ本文の横組み");
        s.fillRect(hx - 8, hy - 8, hw + 16, hh + 16, 0xff20283a);
        var hr = s.drawShapedTextArea(hx, hy, hw, hh, body, 0xc8d4e8, f, 0, -1, 6);
        resetFont(); s.font.height = 16;
        if (hr !== void)
            s.drawText(hx - 8, hy + hh + 14,
                       "lines=" + hr.lines + " height=" + hr.height
                       + " count=" + hr.count, 0x8fb8e8, 255);

        // ---- 正立 / 横倒しの組み分け ---------------------------------
        var mx = 700, my = 178, mw = 152, mh = 196;
        head(mx - 8, my - 34, "orientation — 和欧の組み分け");
        var msample = "縦組み ABC 123 の例";
        var mf = new Font();
        mf.face = chain; mf.height = 18;
        for (var i = 0; i <= 2; i++) {
            var px = mx + i * 176;
            s.fillRect(px - 8, my - 8, mw + 16, mh + 16, 0xff20283a);
            var mo = currentOptions();
            mo["orientation"] = i;
            s.drawVerticalTextArea(px, my, mw, mh, msample, 0xe8ecf4, mf, -1, 6, mo);
            resetFont(); s.font.height = 16;
            s.drawText(px - 8, my + mh + 12, oriName(i), (i == ori) ? 0xffe0a0 : 0x8fb8e8, 255);
        }

        // ---- タイプライタ (count 制限) -------------------------------
        twX = 700; twY = 448; twW = 520; twH = 190;
        head(twX - 8, twY - 30, "count 制限 = タイプライタ (自動再生)");
        var m = s.measureVerticalTextArea(twW, twH, twText, twFont, -1, 6, o);
        twTotal = (m !== void) ? m.totalCount : 0;
        twCount = 0; twNextTick = 0;
        drawTypewriter();

        s.update();
    }

    // タイプライタ枠 + 現在の count を描画する
    function drawTypewriter()
    {
        var s = stage;
        s.fillRect(twX - 8, twY - 8, twW + 16, twH + 16, 0xff20283a);
        s.drawVerticalTextArea(twX, twY, twW, twH, twText, 0xffe0a0, twFont,
                               twCount, 6, currentOptions());
        // クリアはセル高より広めに取る (実グリフはセル高 16px を数 px はみ出す)
        s.fillRect(twX - 8, twY + twH + 8, twW + 16, 26, 0xff181c24);
        resetFont(); s.font.height = 16;
        s.drawText(twX - 8, twY + twH + 12, "count = " + twCount + " / " + twTotal, 0x8fb8e8, 255);
    }

    function onDemoFrame(tick)
    {
        if (twTotal <= 0) return;             // glyphware 無効ビルド等
        if (tick < twNextTick) return;
        if (twCount >= twTotal) {
            twCount = 0;                      // 全文表示後は空に戻して繰り返し
            twNextTick = tick + 500;
        } else {
            twCount++;
            twNextTick = tick + (twCount >= twTotal ? 1500 : 60);
        }
        drawTypewriter();
    }

    function onKeyDown(key, shift)
    {
        switch (key) {
        case VK_1: hanging = !hanging; draw(); break;
        case VK_2: justify = !justify; draw(); break;
        case VK_3: punctuation = !punctuation; draw(); break;
        case VK_4: vlr = !vlr; draw(); break;
        case VK_5: case VK_SPACE: ori = (ori + 1) % 3; draw(); break;
        case VK_LEFT:  lsIdx = (lsIdx + lsList.count - 1) % lsList.count; draw(); break;
        case VK_RIGHT: lsIdx = (lsIdx + 1) % lsList.count; draw(); break;
        }
    }

    function onDemoTest()
    {
        var ok = (typeof global.Layer.drawVerticalTextArea != "undefined") ? 1 : 0;
        dm(@"@demotest:text_vertical avail=${ok} tw=${twCount}/${twTotal}");
    }
}
