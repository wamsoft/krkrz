// -*- mode:tjs2 -*-
// ======================================================================
//  text_font シーン (TextFontScene) — フォントと文字描画
// ======================================================================

// 文字列表。フォントの見本文 (各国語のサンプル・縦書き本文・絵文字列・
// 「太字 Bold」等の装飾見本) は表示そのものがデモの目的なので訳さない。
I18n.add(%[
    "text_font.shell"           => %[ ja : "text_font — フォントと文字描画", en : "text_font — Fonts and text drawing" ],
    "text_font.title"           => %[ ja : "フォントと文字描画", en : "Fonts and text drawing" ],
    "text_font.info"            => %[ ja : "フォント / 文字描画の一覧", en : "Overview of fonts / text drawing" ],
    "text_font.h.size"          => %[ ja : "サイズ (font.height)", en : "Size (font.height)" ],
    "text_font.h.deco"          => %[ ja : "装飾 (bold / italic / underline / strikeout)",
                                         en : "Decoration (bold / italic / underline / strikeout)" ],
    "text_font.h.aa"            => %[ ja : "アンチエイリアス (drawText の aa 引数)", en : "Anti-aliasing (drawText aa argument)" ],
    "text_font.aa.on"           => %[ ja : "aa=true 滑らか", en : "aa=true smooth" ],
    "text_font.aa.off"          => %[ ja : "aa=false ギザギザ", en : "aa=false jagged" ],
    "text_font.h.shadow"        => %[ ja : "影 (shadow)", en : "Shadow" ],
    "text_font.h.measure"       => %[ ja : "文字幅計測 (getTextWidth) — 枠が実際の幅", en : "Text width (getTextWidth) — box = actual width" ],
    "text_font.h.color"         => %[ ja : "drawText の色は 0xRRGGBB (24bit)", en : "drawText color is 0xRRGGBB (24-bit)" ],
    "text_font.color.ok"        => %[ ja : "0xffffff (正) → 白", en : "0xffffff (right) → white" ],
    "text_font.color.ng"        => %[ ja : "0xffffffff (誤) → システムカラー扱い", en : "0xffffffff (wrong) → system color" ],
    "text_font.color.ngdemo"    => %[ ja : "  ← これは 0xffffffff 指定 (黒化)", en : "  ← this is 0xffffffff (turns black)" ],
    "text_font.h.list"          => %[ ja : "フォント一覧 (Font.getList) — %d 件", en : "Font list (Font.getList) — %d" ],
    "text_font.list.none"       => %[ ja : "(この環境ではフォント列挙が使えません)", en : "(font enumeration not available here)" ],
    "text_emoji.title"          => %[ ja : "絵文字 (FreeType)", en : "Emoji (FreeType)" ],
    "text_emoji.info"           => %[ ja : "font.emojiMode で 元フォント / 絵文字フォント を切替 (FreeType 専用)",
                                         en : "font.emojiMode switches base font / emoji font (FreeType only)" ],
    "text_emoji.heading"        => %[ ja : "絵文字表示 (FreeType ラスタライザ)", en : "Emoji display (FreeType rasterizer)" ],
    "text_emoji.h.mode"         => %[ ja : "font.emojiMode : 0=元フォントのみ / 1=モノクロ絵文字 / 2=カラー絵文字",
                                         en : "font.emojiMode : 0=base font only / 1=monochrome emoji / 2=color emoji" ],
    "text_emoji.n1"             => %[ ja : "・該当コードポイントを絵文字フォント (Noto Emoji) にフォールバックして描画",
                                         en : "- Falls back to the emoji font (Noto Emoji) for those code points" ],
    "text_emoji.n2"             => %[ ja : "・絵文字フォントは実行ファイルに埋め込み済み。Font.emojiFaceName / Font.addFont で差替も可",
                                         en : "- The emoji font is embedded in the engine. Replace via Font.emojiFaceName / Font.addFont" ],
    "text_emoji.n3"             => %[ ja : "・GDI ラスタライザ (WINVER 既定) には無い機能。この画面のみ FreeType(=0) を使用",
                                         en : "- Not in the GDI rasterizer (WINVER default). This page uses FreeType (=0)" ],
    "text_emoji.noft"           => %[ ja : "(この環境では FreeType ラスタライザが使えません)", en : "(FreeType rasterizer not available here)" ],
    "text_emoji.h.cmp"          => %[ ja : "モード比較 (同じ文字列)", en : "Mode comparison (same string)" ],
    "text_emoji.m0"             => %[ ja : "mode0 : 絵文字は元フォントに無いため tofu (□) 表示",
                                         en : "mode0 : emoji are not in the base font, so tofu (□)" ],
    "text_emoji.m1"             => %[ ja : "mode1 : モノクロ絵文字グリフ (Noto Emoji)",
                                         en : "mode1 : monochrome emoji glyphs (Noto Emoji)" ],
    "text_emoji.m2"             => %[ ja : "mode2 : カラー絵文字グリフ (Noto Color Emoji)。★❤ 等は元フォントにもあるため mono になる場合あり",
