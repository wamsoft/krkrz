    "text_vertical.na"          => %[ ja : "この環境では drawVerticalTextArea が使えません (glyphware 無効ビルド)",
                                         en : "drawVerticalTextArea is not available here (glyphware disabled build)" ],
    "text_vertical.heading"     => %[ ja : "縦組み描画 (Layer.drawVerticalTextArea)",
                                         en : "Vertical text (Layer.drawVerticalTextArea)" ],
    "text_vertical.n1"          => %[ ja : "・和文は正立 / 欧文・数字は横倒し。約物の詰め・行頭行末禁則・追い込み/追い出しを JLReq のアキ量で処理",
