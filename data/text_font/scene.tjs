    "text_rasterizer.h.measure" => %[ ja : "文字幅計測 (getTextWidth) — 枠が実幅", en : "Text width (getTextWidth) — box = actual width" ],
    "text_rasterizer.h.notes"   => %[ ja : "備考", en : "Notes" ],
    "text_rasterizer.n1"        => %[ ja : "・同じ TJS コード (drawText) で描画。ラスタライザだけ切替",
                                         en : "- Same TJS code (drawText); only the rasterizer changes" ],
    "text_rasterizer.n2"        => %[ ja : "・glyphware = FreeType + HarfBuzz の統一フォントエンジン",
                                         en : "- glyphware = unified font engine (FreeType + HarfBuzz)" ],
