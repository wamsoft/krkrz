    "text_rasterizer.h.deco"    => %[ ja : "装飾 (bold / italic / underline / strikeout)",
                                         en : "Decoration (bold / italic / underline / strikeout)" ],
    "text_rasterizer.h.shadow"  => %[ ja : "影 / ぼかし影 (shadow)", en : "Shadow / blurred shadow" ],
    "text_rasterizer.h.rot"     => %[ ja : "回転 (font.angle=300)", en : "Rotation (font.angle=300)" ],
