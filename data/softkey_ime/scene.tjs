// -*- mode:tjs2 -*-
// ======================================================================
//  softkey_ime シーン (SoftkeyImeScene)
//    文字入力まわりを 1 画面で試す:
//      - Window.onTextInput         … 文字列単位のテキスト入力 (IME 確定文字列を含む) を受ける
//      - Layer.imeMode / attention  … 入力欄に応じた IME の開閉と変換候補位置
//      - ElementsDialog.virtualKeyboard     … 内蔵仮想キーボード (auto/always/never)
//      - ElementsDialog.hasPhysicalKeyboard … 物理キーボードの有無
//      - System.inputString         … モーダルなテキスト入力
//      - Clipboard.asText / hasFormat … クリップボードの読み書き
//
//    キーボードが無い環境 (コンソール/モバイル) では内蔵仮想キーボードが
//    入力欄の focus に応じて出る。 デスクトップでも "always" で強制表示できる。
// ======================================================================

I18n.add(%[
    "softkey_ime.title"        => %[ ja : "文字入力 / 仮想キーボード / IME", en : "Text input / virtual keyboard / IME" ],
    "softkey_ime.shell"        => %[ ja : "softkey_ime — 文字入力 / 仮想キーボード / IME", en : "softkey_ime — Text input / virtual keyboard / IME" ],
    "softkey_ime.info"         => %[ ja : "キーを打つと onTextInput で文字が届く。パネルで IME / 仮想キーボードを切り替え",
                                     en : "Typed text arrives via onTextInput. Switch IME / virtual keyboard in the panel" ],
    "softkey_ime.clip.none"    => %[ ja : "(未操作)",           en : "(not used yet)" ],
    "softkey_ime.input.none"   => %[ ja : "(未実行)",           en : "(not run yet)" ],
    "softkey_ime.help1"        => %[ ja : "文字入力は onKeyDown (仮想キーコード) ではなく onTextInput (文字列そのもの) で受ける。IME の確定文字列もここへ届く。",
                                     en : "Receive text with onTextInput (the string itself), not onKeyDown (virtual key codes). IME commits arrive here too." ],
    "softkey_ime.help2"        => %[ ja : "キーボードが無い環境では、入力欄の focus に応じて内蔵仮想キーボードが出る (パネルで強制表示できる)。",
                                     en : "Without a keyboard, the built-in virtual keyboard appears when an input field gets focus (can be forced in the panel)." ],
    "softkey_ime.card.field"   => %[ ja : "入力欄 (自前描画 + onTextInput)", en : "Input field (self-drawn + onTextInput)" ],
    "softkey_ime.field.help"   => %[ ja : "BackSpace = 1 文字消す / Enter = 確定してログへ", en : "BackSpace = delete one char / Enter = commit to the log" ],
    "softkey_ime.card.keys"    => %[ ja : "受信した文字 (onTextInput)", en : "Received text (onTextInput)" ],
    "softkey_ime.keys.empty"   => %[ ja : "(まだ入力がありません。ウィンドウをクリックしてから打鍵)", en : "(No input yet. Click the window, then type)" ],
    "softkey_ime.card.status"  => %[ ja : "状態",               en : "Status" ],
    "softkey_ime.row.ime"      => %[ ja : "IME モード",         en : "IME mode" ],
    "softkey_ime.row.vk"       => %[ ja : "仮想キーボード",     en : "Virtual keyboard" ],
    "softkey_ime.na"           => %[ ja : "(未提供)",           en : "(not available)" ],
    "softkey_ime.row.phys"     => %[ ja : "物理キーボード",     en : "Physical keyboard" ],
    "softkey_ime.present"      => %[ ja : "あり",               en : "yes" ],
    "softkey_ime.absent"       => %[ ja : "なし",               en : "no" ],
    "softkey_ime.unknown"      => %[ ja : "(不明)",             en : "(unknown)" ],
    "softkey_ime.focus.field"  => %[ ja : "入力欄",             en : "input field" ],
    "softkey_ime.focus.other"  => %[ ja : "(別のレイヤ)",       en : "(another layer)" ],
    "softkey_ime.row.ebox"     => %[ ja : "Elements 欄",        en : "Elements box" ],
    "softkey_ime.empty"        => %[ ja : "(空)",               en : "(empty)" ],
    "softkey_ime.clip.head"    => %[ ja : "-- クリップボード --", en : "-- Clipboard --" ],
    "softkey_ime.clip.has"     => %[ ja : "テキストあり: ",     en : "Has text: " ],
    "softkey_ime.yes"          => %[ ja : "はい",               en : "yes" ],
    "softkey_ime.no"           => %[ ja : "いいえ",             en : "no" ],
    "softkey_ime.note1"        => %[ ja : "IME は WINVER の実装。SDL 版は", en : "IME is implemented in WINVER." ],
    "softkey_ime.note2"        => %[ ja : "OS 側の入力に任せる (値は保持のみ)", en : "SDL leaves it to the OS (value kept only)" ],
    "softkey_ime.surrogate"    => %[ ja : "(サロゲートペア)",   en : "(surrogate pair)" ],
    "softkey_ime.set.ime"      => %[ ja : "IME モード: %s (効くのは WINVER)", en : "IME mode: %s (effective on WINVER)" ],
    "softkey_ime.set.vk"       => %[ ja : "仮想キーボード: ",   en : "Virtual keyboard: " ],
    "softkey_ime.set.vkalways" => %[ ja : " (入力欄に focus すると出ます)", en : " (appears when an input field has focus)" ],
    "softkey_ime.set.novk"     => %[ ja : "ElementsDialog.virtualKeyboard がこのビルドには無い", en : "ElementsDialog.virtualKeyboard is not in this build" ],
    "softkey_ime.clip.noclass" => %[ ja : "Clipboard 未提供",   en : "Clipboard not available" ],
    "softkey_ime.clip.copy"    => %[ ja : "コピー: \"%s\"",   en : "Copied: \"%s\"" ],
    "softkey_ime.clip.notext"  => %[ ja : "クリップボードにテキストなし", en : "No text on the clipboard" ],
    "softkey_ime.clip.paste"   => %[ ja : "貼り付け: \"%s\"", en : "Pasted: \"%s\"" ],
    "softkey_ime.is.caption"   => %[ ja : "入力",               en : "Input" ],
    "softkey_ime.is.prompt"    => %[ ja : "文字を入力してください", en : "Please enter text" ],
    "softkey_ime.is.cancel"    => %[ ja : "(キャンセル)",       en : "(cancelled)" ],
    "softkey_ime.panel.title"  => %[ ja : "入力の設定",         en : "Input settings" ],
    "softkey_ime.panel.ime"    => %[ ja : "IME モード (Layer.imeMode)", en : "IME mode (Layer.imeMode)" ],
    "softkey_ime.panel.vk"     => %[ ja : "仮想キーボード (ElementsDialog.virtualKeyboard)", en : "Virtual keyboard (ElementsDialog.virtualKeyboard)" ],
    "softkey_ime.panel.ebox"   => %[ ja : "Elements 入力欄 (クリックで focus)", en : "Elements input box (click to focus)" ],
    "softkey_ime.panel.eboxph" => %[ ja : "ここに focus すると仮想キーボード", en : "Focus here for the virtual keyboard" ],
    "softkey_ime.panel.copy"   => %[ ja : "コピー",             en : "Copy" ],
    "softkey_ime.panel.paste"  => %[ ja : "貼り付け",           en : "Paste" ],
    "softkey_ime.panel.input"  => %[ ja : "System.inputString で入力", en : "Input via System.inputString" ],
    "softkey_ime.panel.clear"  => %[ ja : "入力欄とログを消去", en : "Clear field and log" ]
]);

class SoftkeyImeScene extends DemoScene
{
    // --- レイアウト ---
    var FX = 24,  FY = 128, FW = 560, FH = 210;    // 入力欄
    var KX = 24,  KY = 352, KW = 560, KH = 308;    // 受信キーのログ
    var IX = 600, IY = 128, IW = 330, IH = 532;    // 状態 / クリップボード

    var text = "";              // 自前入力欄の内容
    var caretOn = true;
    var caretTick = 0;

    var keyLog = [];            // 受信した文字のログ
    var KEY_MAX = 11;

    var imeModeIndex = 1;       // imDisable / imOpen / imClose ...
    var imeNames = ["imDisable", "imClose", "imOpen", "imDontCare"];
    var imeValues = [];

    var vkIndex = 0;            // 0=auto 1=always 2=never
    var vkNames = ["auto", "always", "never"];
    var vkAvailable = false;

    var elementsText = "";      // Elements 入力欄 (仮想キーボードの受け皿)
    var clipNote = "";         // create で入れる
    var lastInput = "";
    var dirty = false;

    var field;                  // 入力欄レイヤ (focusable。IME モードの受け皿)

    function SoftkeyImeScene() { super.DemoScene(I18n.entry("softkey_ime.title")); }

    function create()
    {
        text = "";
        keyLog = [];
        clipNote = I18n.t("softkey_ime.clip.none");
        lastInput = I18n.t("softkey_ime.input.none");
        elementsText = "";
        caretTick = System.getTickCount();

        // imDisable 等はグローバル定数。 ビルドによって無い場合に備えて拾う
        imeValues = [];
        imeValues.add(typeof global.imDisable  != "undefined" ? imDisable  : 0);
        imeValues.add(typeof global.imClose    != "undefined" ? imClose    : 0);
        imeValues.add(typeof global.imOpen     != "undefined" ? imOpen     : 0);
        imeValues.add(typeof global.imDontCare != "undefined" ? imDontCare : 0);

        // 仮想キーボードの制御は ElementsDialog クラスの static 相当プロパティ
        vkAvailable = hasElements() && (typeof ElementsDialog.virtualKeyboard != "undefined");
        if (vkAvailable) {
            var cur = ElementsDialog.virtualKeyboard;
            for (var i = 0; i < vkNames.count; i++) if (vkNames[i] == cur) vkIndex = i;
        }

        stage.fillRect(0, 0, 1280, 720, 0xff141821);
        drawStatic();

        // 入力欄レイヤ: focusable にして IME の対象にする。 描画は自前。
        field = new Layer(window, stage);
        field.setSize(FW - 32, 48);
        field.setPos(FX + 16, FY + 74);
        field.type = ltOpaque;
        field.focusable = true;
        field.visible = true;
        window.add(field);
        applyIme();
        field.focus();

        redrawField();
        redrawKeys();
        redrawInfo();
        setInfo(I18n.t("softkey_ime.info"));
        showPanelDict(panelDict());
    }

    function onExit()
    {
        // 仮想キーボードの強制表示を残さない
        if (vkAvailable && vkIndex != 0) { ElementsDialog.virtualKeyboard = "auto"; vkIndex = 0; }
        field = void;   // レイヤは shell が stage ごと破棄する
    }

    // ------------------------------------------------------------------
    function drawStatic()
    {
        stage.font.height = 19;
        stage.drawText(24, 44, I18n.t("softkey_ime.title"), 0xffd76a, 255);
        stage.font.height = 15;
        stage.drawText(24, 76, I18n.t("softkey_ime.help1"), 0xc8d2e4, 255);
        stage.drawText(24, 98, I18n.t("softkey_ime.help2"), 0xc8d2e4, 255);
        stage.update();
    }

    function card(x, y, w, h, title)
    {
        stage.fillRect(x, y, w, h, 0xff1b2130);
        stage.font.height = 17;
        stage.drawText(x + 12, y + 10, title, 0xffd76a, 255);
        stage.font.height = 15;
    }

    function row(x, y, label, value, col)
    {
        if (col === void) col = 0xdfe6f2;
        stage.drawText(x + 12, y, label, 0x9fb0c8, 255);
        stage.drawText(x + 150, y, value, col, 255);
        return y + 24;
    }

    // --- 入力欄 --------------------------------------------------------
    function redrawField()
    {
        card(FX, FY, FW, FH, I18n.t("softkey_ime.card.field"));
        stage.font.height = 14;
        stage.drawText(FX + 16, FY + 44, I18n.t("softkey_ime.field.help"), 0x8899b0, 255);
        stage.font.height = 15;
        stage.update(FX, FY, FW, FH);
        drawFieldText();
    }

    function drawFieldText()
    {
        if (!(isvalid field)) return;
        field.fillRect(0, 0, field.width, field.height, 0xff101520);
        field.font.height = 24;
        var shown = text + (caretOn ? "|" : "");
        field.drawText(10, 10, shown, 0xdfe6f2, 255);
        field.update();
    }

    // --- キーログ ------------------------------------------------------
    function redrawKeys()
    {
        card(KX, KY, KW, KH, I18n.t("softkey_ime.card.keys"));
        var y = KY + 40;
        stage.font.height = 14;
        if (keyLog.count == 0) {
            stage.drawText(KX + 12, y, I18n.t("softkey_ime.keys.empty"), 0x9fb0c8, 255);
        } else {
            for (var i = 0; i < keyLog.count; i++) {
                stage.drawText(KX + 12, y, keyLog[i], 0xdfe6f2, 255);
                y += 22;
            }
        }
        stage.font.height = 15;
        stage.update(KX, KY, KW, KH);
    }

    function addKeyLog(line)
    {
        keyLog.add(line);
        while (keyLog.count > KEY_MAX) keyLog.erase(0);
        dirty = true;
    }

    // --- 状態 ----------------------------------------------------------
    function redrawInfo()
    {
        card(IX, IY, IW, IH, I18n.t("softkey_ime.card.status"));
        var y = IY + 40;
        y = row(IX, y, I18n.t("softkey_ime.row.ime"), imeNames[imeModeIndex]);
        y = row(IX, y, I18n.t("softkey_ime.row.vk"), vkAvailable ? vkNames[vkIndex] : I18n.t("softkey_ime.na"),
                vkAvailable ? 0xdfe6f2 : 0x9fb0c8);
        y = row(IX, y, I18n.t("softkey_ime.row.phys"),
                vkAvailable ? I18n.t(ElementsDialog.hasPhysicalKeyboard ? "softkey_ime.present" : "softkey_ime.absent") : I18n.t("softkey_ime.unknown"));
        y = row(IX, y, "focus", (isvalid field && window.focusedLayer == field) ? I18n.t("softkey_ime.focus.field") : I18n.t("softkey_ime.focus.other"));
        y = row(IX, y, I18n.t("softkey_ime.row.ebox"), elementsText != "" ? elementsText : I18n.t("softkey_ime.empty"));
        y += 10;
        stage.font.height = 14;
        stage.drawText(IX + 12, y, I18n.t("softkey_ime.clip.head"), 0xffd76a, 255); y += 22;
        var has = false;
        if (typeof global.Clipboard != "undefined") {
            try { has = Clipboard.hasFormat(cbfText); } catch (e) { }
        }
        stage.drawText(IX + 12, y, I18n.t("softkey_ime.clip.has") + I18n.t(has ? "softkey_ime.yes" : "softkey_ime.no"), 0xdfe6f2, 255); y += 22;
        var cn = clipNote;
        for (var i = 0; i < 3 && cn != ""; i++) {
            stage.drawText(IX + 12, y, cn.substring(0, 22), 0x9fd6a0, 255);
            cn = cn.substring(22);
            y += 20;
        }
        y += 10;
        stage.drawText(IX + 12, y, "-- System.inputString --", 0xffd76a, 255); y += 22;
        var li = lastInput;
        for (var i = 0; i < 3 && li != ""; i++) {
            stage.drawText(IX + 12, y, li.substring(0, 22), 0xdfe6f2, 255);
            li = li.substring(22);
            y += 20;
        }
        y += 12;
        stage.drawText(IX + 12, y, I18n.t("softkey_ime.note1"), 0x8899b0, 255); y += 18;
        stage.drawText(IX + 12, y, I18n.t("softkey_ime.note2"), 0x8899b0, 255); y += 18;
        stage.font.height = 15;
        stage.update(IX, IY, IW, IH);
    }

    // ------------------------------------------------------------------
    function applyIme()
    {
        if (!(isvalid field)) return;
        // Layer.imeMode: そのレイヤに focus がある間の IME 状態。
        // 変換候補ウィンドウの位置は setAttentionPoint で指示する (WINVER)。
        field.imeMode = imeValues[imeModeIndex];
        if (typeof field.setAttentionPoint != "undefined") {
            field.setAttentionPoint(10, field.height - 4, field.font);
        }
    }

    // --- 入力イベント ---------------------------------------------------
    // 文字入力は onTextInput (文字列単位) で受ける。IME の確定文字列は
    // まとまって 1 回で届く。制御文字 (BS/Enter) は文字としては来ないので
    // onKeyDown の仮想キーコードで受ける (SDL / WINVER 共通の受け方)。
    function onTextInput(elmtext)
    {
        text += elmtext;
        // ログは 1 コードポイントずつ (サロゲートペアは 2 unit で 1 文字)。
        // TJS2 では str[i] は 1 文字の文字列。コードは # 演算子で取る
        for (var i = 0; i < elmtext.length; i++) {
            var code = #(elmtext.substring(i, 1));
            var ch;
            if (code >= 0xD800 && code <= 0xDBFF && i + 1 < elmtext.length) {
                ch = elmtext.substring(i, 2); i++;
                addKeyLog("'" + ch + "'  " + I18n.t("softkey_ime.surrogate"));
            } else {
                ch = elmtext.substring(i, 1);
                addKeyLog("'" + ch + "'  U+" + "%04X".sprintf(code));
            }
        }
        dirty = true;
    }

    function onKeyDown(key, shift)
    {
        if (key == VK_BACK) {                  // BackSpace
            if (text.length > 0) {
                // コードポイント単位で消す (末尾がサロゲートペアなら 2 unit)
                var n = 1;
                if (text.length >= 2) {
                    var last = #(text.substring(text.length - 1, 1));
                    var prev = #(text.substring(text.length - 2, 1));
                    if (last >= 0xDC00 && last <= 0xDFFF &&
                        prev >= 0xD800 && prev <= 0xDBFF) n = 2;
                }
                text = text.substring(0, text.length - n);
            }
            addKeyLog("BS (VK_BACK)");
            dirty = true;
        } else if (key == VK_RETURN) {         // Enter
            addKeyLog("Enter → \"" + text + "\"");
            text = "";
            dirty = true;
        }
    }

    function onMouseDown(x, y, button, shift)
    {
        // 入力欄をクリックしたら focus を戻す (仮想キーボードは focus 駆動)
        if (isvalid field) { field.focus(); dirty = true; }
    }

    // ------------------------------------------------------------------
    function onDemoFrame(tick)
    {
        if (tick - caretTick >= 500) {
            caretTick = tick;
            caretOn = !caretOn;
            drawFieldText();
        }
        if (dirty) {
            dirty = false;
            drawFieldText();
            redrawKeys();
            redrawInfo();
        }
    }

    function onPanelAction(id, payload)
    {
        switch (id) {
        case "ime":
            imeModeIndex = Math.floor(payload + 0.5);
            applyIme();
            setInfo(I18n.t("softkey_ime.set.ime", imeNames[imeModeIndex]));
            dirty = true;
            break;

        case "vk":
            vkIndex = Math.floor(payload + 0.5);
            if (vkAvailable) {
                ElementsDialog.virtualKeyboard = vkNames[vkIndex];
                setInfo(I18n.t("softkey_ime.set.vk") + vkNames[vkIndex]
                        + (vkNames[vkIndex] == "always" ? I18n.t("softkey_ime.set.vkalways") : ""));
            } else {
                setInfo(I18n.t("softkey_ime.set.novk"));
            }
            dirty = true;
            break;

        case "copy":
            if (typeof global.Clipboard == "undefined") { clipNote = I18n.t("softkey_ime.clip.noclass"); }
            else {
                Clipboard.asText = text;
                clipNote = I18n.t("softkey_ime.clip.copy", text);
            }
            dirty = true;
            break;

        case "paste":
            if (typeof global.Clipboard == "undefined") { clipNote = I18n.t("softkey_ime.clip.noclass"); }
            else {
                var v = Clipboard.asText;
                // テキストが無いと void が返る
                if (v === void) { clipNote = I18n.t("softkey_ime.clip.notext"); }
                else { text += v; clipNote = I18n.t("softkey_ime.clip.paste", v); }
            }
            dirty = true;
            break;

        case "input":
            // モーダルなテキスト入力 (Elements 実装)。閉じるまで戻らない
            var r = System.inputString(I18n.t("softkey_ime.is.caption"), I18n.t("softkey_ime.is.prompt"), text);
            lastInput = (r === void) ? I18n.t("softkey_ime.is.cancel") : ("\"" + r + "\"");
            if (r !== void) text = r;
            dirty = true;
            break;

        case "ebox":
            // Elements の input_box。 ここに focus が入っている間だけ
            // 仮想キーボード / テキスト入力がこのウィジェットへ向く
            elementsText = payload;
            dirty = true;
            break;

        case "clear":
            text = "";
            keyLog = [];
            elementsText = "";
            dirty = true;
            break;
        }
    }

    function onDemoTest()
    {
        var hasClip = (typeof global.Clipboard != "undefined") ? 1 : 0;
        var focused = (isvalid field && window.focusedLayer == field) ? 1 : 0;
        dm(@"@demotest:softkey_ime vk=${vkAvailable ? vkNames[vkIndex] : "none"} ime=${imeNames[imeModeIndex]} clipboard=${hasClip} focused=${focused}");
    }

    // ------------------------------------------------------------------
    function panelDict()
    {
        return %[
            size : [320, 486], background : [26, 30, 40, 236],
            align : "bottom_right", margin : 16,
            content : %[ type : "margin", padding : 14, child : %[ type : "vtile", children : [
                %[ type : "vsize", height : 0, child : %[ type : "hspacer", width : 288 ] ],
                %[ type : "align_center", child : %[ type : "label", text : I18n.t("softkey_ime.panel.title"), size_scale : 1.2 ] ],
                %[ type : "vspacer", height : 8 ],
                %[ type : "label", text : I18n.t("softkey_ime.panel.ime") ],
                %[ type : "framed_cycle_picker", id : "ime", options : imeNames, initial : imeModeIndex ],
                %[ type : "vspacer", height : 6 ],
                %[ type : "label", text : I18n.t("softkey_ime.panel.vk") ],
                %[ type : "segmented_picker", id : "vk", options : vkNames, initial : vkIndex ],
                %[ type : "vspacer", height : 8 ],
                %[ type : "label", text : I18n.t("softkey_ime.panel.ebox") ],
                %[ type : "input_box", id : "ebox", placeholder : I18n.t("softkey_ime.panel.eboxph") ],
                %[ type : "vspacer", height : 12 ],
                %[ type : "htile", children : [
                    %[ type : "button", id : "copy",  text : I18n.t("softkey_ime.panel.copy") ],
                    %[ type : "hspacer", width : 8 ],
                    %[ type : "button", id : "paste", text : I18n.t("softkey_ime.panel.paste") ]
                ] ],
                %[ type : "vspacer", height : 8 ],
                %[ type : "button", id : "input", text : I18n.t("softkey_ime.panel.input") ],
                %[ type : "vspacer", height : 8 ],
                %[ type : "button", id : "clear", text : I18n.t("softkey_ime.panel.clear") ]
            ] ] ]
        ];
    }
}
