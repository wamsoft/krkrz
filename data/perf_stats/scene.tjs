// -*- mode:tjs2 -*-
// ======================================================================
//  perf_stats シーン (PerfStatsScene)
//    画面転送コスト (System.renderStats) とメモリ / アロケータの状態を
//    実負荷をかけながら観測する。 「fps だけ見ても詰まりは分からない」ので、
//    転送回数・転送バイト数・転送に使った時間の割合を数値で見るためのデモ。
//
//    負荷パターンを切り替えると、同じ fps でも転送コストがまるで違うことが
//    分かる (小矩形を多数 vs 全面 1 枚)。 texUploadUsePBO の A/B もここで
//    試せる。
// ======================================================================

I18n.add(%[
    "perf_stats.title"          => %[ ja : "転送コストとメモリ計測",       en : "Upload cost and memory" ],
    "perf_stats.shell"          => %[ ja : "perf_stats — 転送コストとメモリ計測", en : "perf_stats — upload cost and memory" ],
    "perf_stats.load.0"         => %[ ja : "なし (静止)",                   en : "none (static)" ],
    "perf_stats.load.1"         => %[ ja : "小矩形 x N",                    en : "small rects x N" ],
    "perf_stats.load.2"         => %[ ja : "全面塗り",                      en : "full fill" ],
    "perf_stats.load.3"         => %[ ja : "中矩形アニメ",                  en : "moving rect" ],
    "perf_stats.pbo.0"          => %[ ja : "既定 (サイズで自動)",           en : "default (auto by size)" ],
    "perf_stats.pbo.1"          => %[ ja : "常に PBO",                      en : "always PBO" ],
    "perf_stats.pbo.2"          => %[ ja : "常に直接転送",                  en : "always direct" ],
    "perf_stats.info"           => %[ ja : "負荷パターンを切り替えて、fps ではなく転送コストの違いを見る",
                                      en : "Switch load patterns and compare upload cost, not fps" ],
    "perf_stats.heading"        => %[ ja : "画面転送コストとメモリの計測",  en : "Screen upload cost and memory" ],
    "perf_stats.desc1"          => %[ ja : "合成済み画面を GPU テクスチャへ送るコストは、更新の「面積」ではなく「回数と分布」で大きく変わる。",
                                      en : "The cost of sending the composited screen to a GPU texture depends on the count and spread of updates, not their area." ],
    "perf_stats.desc2"          => %[ ja : "同じ fps でも転送で詰まっていることがあるので、System.renderStats の差分で常時観測する。",
                                      en : "Uploads can stall even at the same fps, so watch the deltas of System.renderStats." ],
    "perf_stats.load_area"      => %[ ja : "負荷エリア",                    en : "Load area" ],
    "perf_stats.card.upload"    => %[ ja : "画面転送 (System.renderStats)", en : "Screen upload (System.renderStats)" ],
    "perf_stats.measuring"      => %[ ja : "計測中...",                     en : "Measuring..." ],
    "perf_stats.note.ratio"     => %[ ja : "転送率 = 転送に使った時間 / 経過実時間",
                                      en : "Upload ratio = upload time / elapsed wall time" ],
    "perf_stats.note.refresh"   => %[ ja : "累積値を %d ms ごとに差分化して表示",
                                      en : "Shows deltas of cumulative values every %d ms" ],
    "perf_stats.unsupported"    => %[ ja : "(このビルドでは未提供)",        en : "(not in this build)" ],
    "perf_stats.st.frames"      => %[ ja : "提示フレーム",                  en : "Presented frames" ],
    "perf_stats.st.uploads"     => %[ ja : "転送回数",                      en : "Uploads" ],
    "perf_stats.st.bytes"       => %[ ja : "転送量",                        en : "Upload volume" ],
    "perf_stats.st.perup"       => %[ ja : "転送 1 回あたり",               en : "Per upload" ],
    "perf_stats.st.perframe"    => %[ ja : "フレーム当たり",                en : "Per frame" ],
    "perf_stats.st.time"        => %[ ja : "転送時間",                      en : "Upload time" ],
    "perf_stats.st.ratio"       => %[ ja : "転送率",                        en : "Upload ratio" ],
    "perf_stats.u.persec"       => %[ ja : "%s / 秒",                       en : "%s /s" ],
    "perf_stats.u.mbsec"        => %[ ja : "%s MB/秒",                      en : "%s MB/s" ],
    "perf_stats.u.mssec"        => %[ ja : "%s ms/秒",                      en : "%s ms/s" ],
    "perf_stats.hint.stalled"   => %[ ja : "fps が落ちている = 転送が本当に足を引っ張っている",
                                      en : "fps dropped = uploads really are the bottleneck" ],
    "perf_stats.hint.vsync"     => %[ ja : "fps が出ているので、待ちの多くは vsync 同期ぶん",
                                      en : "fps is fine, so most of the wait is vsync" ],
    "perf_stats.card.memory"    => %[ ja : "メモリ (getSystemAllocatorInfo)", en : "Memory (getSystemAllocatorInfo)" ],
    "perf_stats.note.nokey"     => %[ ja : "取得できない項目はキー自体が無い (環境依存)",
                                      en : "Unavailable items have no key (platform dependent)" ],
    "perf_stats.note.compact"   => %[ ja : "doCompact / clearGraphicCache で解放の効果を見る",
                                      en : "Use doCompact / clearGraphicCache to see the effect" ],
    "perf_stats.mem.used"       => %[ ja : "使用量",                        en : "Used" ],
    "perf_stats.mem.peak"       => %[ ja : "ピーク",                        en : "Peak" ],
    "perf_stats.mem.free"       => %[ ja : "空き",                          en : "Free" ],
    "perf_stats.mem.alloc"      => %[ ja : "最大連続確保可",                en : "Largest allocatable" ],
    "perf_stats.mem.total"      => %[ ja : "ヒープ総量",                    en : "Heap total" ],
    "perf_stats.mem.rss"        => %[ ja : "プロセス RSS",                  en : "Process RSS" ],
    "perf_stats.mem.rsspeak"    => %[ ja : "RSS ピーク",                    en : "RSS peak" ],
    "perf_stats.mem.sysfree"    => %[ ja : "システム空き",                  en : "System free" ],
    "perf_stats.fullfill"       => %[ ja : "全面塗り: 大きい転送 1 回 / フレーム",
                                      en : "Full fill: one large upload per frame" ],
    "perf_stats.msg.load"       => %[ ja : "負荷: %s",                      en : "Load: %s" ],
    "perf_stats.msg.pbo"        => %[ ja : "転送経路: %s",                  en : "Upload path: %s" ],
    "perf_stats.msg.nopbo"      => %[ ja : "texUploadUsePBO はこのビルドには無い (OpenGL 無効)",
                                      en : "texUploadUsePBO is not in this build (OpenGL disabled)" ],
    "perf_stats.msg.reset"      => %[ ja : "計測をリセットした",            en : "Measurement reset" ],
    "perf_stats.msg.compact"    => %[ ja : "doCompact(clAll): キャッシュを解放して GC を実行した",
                                      en : "doCompact(clAll): freed caches and ran GC" ],
    "perf_stats.msg.gcache"     => %[ ja : "clearGraphicCache(): 画像キャッシュを破棄した",
                                      en : "clearGraphicCache(): image cache cleared" ],
    "perf_stats.msg.peak"       => %[ ja : "メモリピークを現在値までリセットした",
                                      en : "Memory peak reset to the current value" ],
    "perf_stats.msg.nopeak"     => %[ ja : "resetMemoryPeak はこのビルドには無い",
                                      en : "resetMemoryPeak is not in this build" ],
    "perf_stats.msg.overlay"    => %[ ja : "メモリオーバレイ: %s (SDL3 ビルド限定)",
                                      en : "Memory overlay: %s (SDL3 build only)" ],
    "perf_stats.msg.shown"      => %[ ja : "表示",                          en : "on" ],
    "perf_stats.msg.hidden"     => %[ ja : "非表示",                        en : "off" ],
    "perf_stats.msg.nooverlay"  => %[ ja : "setMemoryOverlay はこのビルドには無い",
                                      en : "setMemoryOverlay is not in this build" ],
    "perf_stats.panel.title"    => %[ ja : "計測と負荷",                    en : "Measurement and load" ],
    "perf_stats.panel.load"     => %[ ja : "負荷 (0:なし 1:小矩形 2:全面 3:アニメ)",
                                      en : "Load (0:none 1:small 2:full 3:anim)" ],
    "perf_stats.panel.count"    => %[ ja : "小矩形の個数",                  en : "Small rect count" ],
    "perf_stats.panel.pbo"      => %[ ja : "転送経路 (0:既定 1:PBO 2:直接)", en : "Path (0:default 1:PBO 2:direct)" ],
    "perf_stats.panel.reset"    => %[ ja : "計測リセット",                  en : "Reset measurement" ],
    "perf_stats.panel.gcache"   => %[ ja : "画像キャッシュ破棄",            en : "Clear image cache" ],
    "perf_stats.panel.peak"     => %[ ja : "メモリピークをリセット",        en : "Reset memory peak" ],
    "perf_stats.panel.overlay"  => %[ ja : "メモリオーバレイ (SDL3)",       en : "Memory overlay (SDL3)" ]
]);

class PerfStatsScene extends DemoScene
{
    // --- レイアウト ---
    var STX = 24,  STY = 128, STW = 430, STH = 266;    // 転送統計カード
    var MEX = 24,  MEY = 402, MEW = 430, MEH = 258;    // メモリカード
    var LDX = 470, LDY = 128, LDW = 440, LDH = 532;    // 負荷エリア

    // --- 負荷 ---
    var loadMode = 1;        // 0=なし 1=小矩形多数 2=全面塗り 3=中矩形アニメ
    var loadNames = ["perf_stats.load.0", "perf_stats.load.1", "perf_stats.load.2", "perf_stats.load.3"];   // I18n id
    var rectCount = 60;      // 小矩形の個数
    var phase = 0;           // アニメ位相
    var seed = 12345;        // 乱数 (再現性のため自前 LCG)
    var prevBx, prevBy;      // 中矩形アニメ: 直前の位置 (消す矩形)

    // --- 計測 ---
    var prev;                // 前回の renderStats スナップ (void = 未計測)
    var prevTick = 0;
    var lastLine = [];       // 表示用に組み立てた行
    var hint = "";           // 数値の読み方ヒント (1 行)
    var memLine = [];
    var refreshTick = 0;
    var REFRESH = 500;       // 統計の更新間隔 (ms)

    var pboMode = 0;         // 0=既定 1=常に PBO 2=常に直接
    var pboNames = ["perf_stats.pbo.0", "perf_stats.pbo.1", "perf_stats.pbo.2"];   // I18n id
    var pboAvailable = false;
    var memOverlay = false;

    function PerfStatsScene() { super.DemoScene(I18n.entry("perf_stats.title")); }

    function create()
    {
        pboAvailable = (typeof System.texUploadUsePBO != "undefined");
        prev = void;
        phase = 0;
        seed = 12345;
        prevBx = void; prevBy = void;
        stage.fillRect(0, 0, 1280, 720, 0xff141821);
        drawStatic();
        drawLoadFrame();
        System.renderStatsReset();
        prevTick = System.getTickCount();
        refreshTick = prevTick;
        redrawStats();
        redrawMemory();
        setInfo(I18n.t("perf_stats.info"));
        enableFps();
        showPanelDict(panelDict());
    }

    function onExit()
    {
        // オーバレイを出しっぱなしにしない
        if (memOverlay && typeof System.setMemoryOverlay != "undefined") {
            System.setMemoryOverlay(false);
            memOverlay = false;
        }
        // PBO 強制指定は他シーンへ持ち越さない
        if (pboAvailable && pboMode != 0) {
            System.texUploadUsePBO = void;
            pboMode = 0;
        }
    }

    // ------------------------------------------------------------------
    function drawStatic()
    {
        stage.font.height = 19;
        stage.drawText(24, 44, I18n.t("perf_stats.heading"), 0xffd76a, 255);
        stage.font.height = 15;
        stage.drawText(24, 76, I18n.t("perf_stats.desc1"), 0xc8d2e4, 255);
        stage.drawText(24, 98, I18n.t("perf_stats.desc2"), 0xc8d2e4, 255);
        stage.update();
    }

    function drawLoadFrame()
    {
        stage.fillRect(LDX, LDY, LDW, LDH, 0xff1b2130);
        stage.font.height = 16;
        stage.drawText(LDX + 12, LDY + 10, I18n.t("perf_stats.load_area"), 0xffd76a, 255);
        stage.update(LDX, LDY, LDW, LDH);
    }

    // --- カード描画ヘルパ ------------------------------------------------
    function card(x, y, w, h, title)
    {
        stage.fillRect(x, y, w, h, 0xff1b2130);
        stage.font.height = 17;
        stage.drawText(x + 12, y + 10, title, 0xffd76a, 255);
        stage.font.height = 15;
    }

    function row(x, y, label, value, col)
    {
        if (col === void) col = 0xdfe6f2;
        stage.drawText(x + 12, y, label, 0x9fb0c8, 255);
        stage.drawText(x + 190, y, value, col, 255);
        return y + 22;
    }

    function mb(bytes) { return "%.1f".sprintf(bytes / 1048576.0) + " MB"; }

    // ------------------------------------------------------------------
    //  転送統計 (System.renderStats の差分)
    // ------------------------------------------------------------------
    function redrawStats()
    {
        card(STX, STY, STW, STH, I18n.t("perf_stats.card.upload"));
        var y = STY + 40;
        if (lastLine.count == 0) {
            y = row(STX, y, I18n.t("perf_stats.measuring"), "");
        } else {
            for (var i = 0; i < lastLine.count; i++) {
                var e = lastLine[i];
                y = row(STX, y, e[0], e[1], e[2]);
            }
        }
        y += 6;
        stage.font.height = 13;
        stage.drawText(STX + 12, y, I18n.t("perf_stats.note.ratio"), 0x8899b0, 255);
        y += 17;
        stage.drawText(STX + 12, y, I18n.t("perf_stats.note.refresh", REFRESH), 0x8899b0, 255);
        y += 17;
        if (hint != "") stage.drawText(STX + 12, y, hint, 0x8899b0, 255);
        stage.font.height = 15;
        stage.update(STX, STY, STW, STH);
    }

    function sampleStats(tick)
    {
        var s = System.renderStats;
        if (s === void) { lastLine = [ [ "renderStats", I18n.t("perf_stats.unsupported"), 0xff9a9a ] ]; return; }
        if (prev === void) { prev = s; prevTick = tick; return; }

        var dt = tick - prevTick;
        if (dt <= 0) return;
        var frames  = s.frames        - prev.frames;
        var uploads = s.texUploads    - prev.texUploads;
        var bytes   = s.texUploadBytes - prev.texUploadBytes;
        var us      = s.texUploadUs   - prev.texUploadUs;
        prev = s;
        prevTick = tick;

        var fps      = frames * 1000.0 / dt;
        var upPerSec = uploads * 1000.0 / dt;
        var mbPerSec = bytes / 1048576.0 * 1000.0 / dt;
        var msPerSec = us / 1000.0 * 1000.0 / dt;      // 1 秒あたり何 ms 転送に使ったか
        var ratio    = us / 10.0 / dt;                  // 転送時間 / 経過時間 (%)
        var perUp    = uploads > 0 ? bytes / uploads : 0;
        var usPerUp  = uploads > 0 ? us / uploads : 0;

        // 転送率が高いほど警告色にする (目視で詰まりが分かるように)。
        // ただし fps が出ているなら、待ちの多くは vsync 同期の肩代わり
        // (転送呼び出しの中で次フレームを待っている) なので警告色にしない。
        var col = 0x9fd6a0;
        var stalled = (fps < 50);
        if (ratio >= 30) col = stalled ? 0xff9a9a : 0xffd76a;
        else if (ratio >= 10) col = 0xffd76a;

        var msPerFrame = frames > 0 ? us / 1000.0 / frames : 0;

        lastLine = [
            [ I18n.t("perf_stats.st.frames"),   I18n.t("perf_stats.u.persec", "%.1f".sprintf(fps)) ],
            [ I18n.t("perf_stats.st.uploads"),  I18n.t("perf_stats.u.persec", "%.1f".sprintf(upPerSec)) ],
            [ I18n.t("perf_stats.st.bytes"),    I18n.t("perf_stats.u.mbsec", "%.2f".sprintf(mbPerSec)) ],
            [ I18n.t("perf_stats.st.perup"),    "%.1f".sprintf(perUp / 1024.0) + " KB / " + "%.0f".sprintf(usPerUp) + " us" ],
            [ I18n.t("perf_stats.st.perframe"), "%.1f".sprintf(msPerFrame) + " ms" ],
            [ I18n.t("perf_stats.st.time"),     I18n.t("perf_stats.u.mssec", "%.1f".sprintf(msPerSec)) ],
            [ I18n.t("perf_stats.st.ratio"),    "%.1f".sprintf(ratio) + " %", col ]
        ];
        hint = stalled ? I18n.t("perf_stats.hint.stalled")
                       : I18n.t("perf_stats.hint.vsync");
    }

    // ------------------------------------------------------------------
    //  メモリ / アロケータ
    // ------------------------------------------------------------------
    function redrawMemory()
    {
        card(MEX, MEY, MEW, MEH, I18n.t("perf_stats.card.memory"));
        var y = MEY + 40;
        if (memLine.count == 0) {
            y = row(MEX, y, I18n.t("perf_stats.unsupported"), "", 0x9fb0c8);
        } else {
            for (var i = 0; i < memLine.count; i++) {
                var e = memLine[i];
                y = row(MEX, y, e[0], e[1]);
            }
        }
        y += 6;
        stage.font.height = 13;
        stage.drawText(MEX + 12, y, I18n.t("perf_stats.note.nokey"), 0x8899b0, 255);
        y += 18;
        stage.drawText(MEX + 12, y, I18n.t("perf_stats.note.compact"), 0x8899b0, 255);
        stage.font.height = 15;
        stage.update(MEX, MEY, MEW, MEH);
    }

    function sampleMemory()
    {
        if (typeof System.getSystemAllocatorInfo == "undefined") { memLine = []; return; }
        var m = System.getSystemAllocatorInfo();
        if (m === void) { memLine = []; return; }
        var out = [];
        // 値が取れなかった項目はキー自体が無いので存在を見てから読む
        if ("usedSize"            in m) out.add([ I18n.t("perf_stats.mem.used"),    mb(m.usedSize) ]);
        if ("peakUsedSize"        in m) out.add([ I18n.t("perf_stats.mem.peak"),    mb(m.peakUsedSize) ]);
        if ("totalFreeSize"       in m) out.add([ I18n.t("perf_stats.mem.free"),    mb(m.totalFreeSize) ]);
        if ("allocatableSize"     in m) out.add([ I18n.t("perf_stats.mem.alloc"),   mb(m.allocatableSize) ]);
        if ("totalSize"           in m) out.add([ I18n.t("perf_stats.mem.total"),   mb(m.totalSize) ]);
        if ("processRss"          in m) out.add([ I18n.t("perf_stats.mem.rss"),     mb(m.processRss) ]);
        if ("processPeakRss"      in m) out.add([ I18n.t("perf_stats.mem.rsspeak"), mb(m.processPeakRss) ]);
        if ("systemAvailPhysical" in m) out.add([ I18n.t("perf_stats.mem.sysfree"), mb(m.systemAvailPhysical) ]);
        memLine = out;
    }

    // ------------------------------------------------------------------
    //  負荷生成
    // ------------------------------------------------------------------
    function rnd(n)
    {
        // 線形合同法。 実行ごとに同じ絵になるようにして A/B 比較を安定させる
        seed = (seed * 1103515245 + 12345) & 0x3fffffff;
        return (seed >> 8) % n;
    }

    function runLoad()
    {
        switch (loadMode) {
        case 0:
            break;

        case 1:
            // 小さいダーティ矩形を多数。 面積は小さいのに転送回数が増える。
            for (var i = 0; i < rectCount; i++) {
                var w = 18, h = 18;
                var x = LDX + 8 + rnd(LDW - 16 - w);
                var y = LDY + 34 + rnd(LDH - 42 - h);
                stage.fillRect(x, y, w, h, 0xff000000 + (rnd(0x00ffffff)));
                stage.update(x, y, w, h);   // 1 矩形 = 1 ダーティ矩形
            }
            break;

        case 2:
            // 毎フレーム全面塗り。 転送回数は 1 回だが 1 回が大きい。
            var c = 0xff102030 + (phase % 128) * 0x00010101;
            stage.fillRect(LDX, LDY + 30, LDW, LDH - 30, c);
            stage.font.height = 16;
            stage.drawText(LDX + 12, LDY + 40, I18n.t("perf_stats.fullfill"), 0xdfe6f2, 255);
            stage.update(LDX, LDY + 30, LDW, LDH - 30);
            break;

        case 3:
            // 中サイズの矩形が動く。 実ゲームのキャラ更新に近い形。
            // ★消す矩形と描く矩形だけを update する。 エリア全面を update する
            //   のに比べて転送量が桁で変わる (「動いた所だけ」の効き目)。
            var bw = 120, bh = 90;
            var span = LDW - 16 - bw;
            var t = phase % (span * 2);
            var bx = LDX + 8 + (t < span ? t : span * 2 - t);
            var by = LDY + 40 + ((phase * 2) % (LDH - 50 - bh));
            if (prevBx !== void) {
                stage.fillRect(prevBx, prevBy, bw, bh, 0xff1b2130);
                stage.update(prevBx, prevBy, bw, bh);
            }
            stage.fillRect(bx, by, bw, bh, 0xff4a90d9);
            stage.update(bx, by, bw, bh);
            prevBx = bx; prevBy = by;
            break;
        }
        phase++;
    }

    // ------------------------------------------------------------------
    function onDemoFrame(tick)
    {
        runLoad();
        if (tick - refreshTick >= REFRESH) {
            refreshTick = tick;
            sampleStats(tick);
            sampleMemory();
            redrawStats();
            redrawMemory();
        }
    }

    function applyPbo()
    {
        if (!pboAvailable) return;
        if (pboMode == 0)      System.texUploadUsePBO = void;
        else if (pboMode == 1) System.texUploadUsePBO = true;
        else                   System.texUploadUsePBO = false;
        resetStats();
    }

    function resetStats()
    {
        System.renderStatsReset();
        prev = void;
        lastLine = [];
        prevTick = System.getTickCount();
    }

    function onPanelAction(id, payload)
    {
        switch (id) {
        case "load":
            loadMode = Math.floor(payload + 0.5);
            prevBx = void; prevBy = void;
            drawLoadFrame();
            resetStats();
            setInfo(I18n.t("perf_stats.msg.load", I18n.t(loadNames[loadMode])));
            break;

        case "count":
            rectCount = Math.floor(payload + 0.5);
            resetStats();
            break;

        case "pbo":
            pboMode = Math.floor(payload + 0.5);
            applyPbo();
            setInfo(pboAvailable ? I18n.t("perf_stats.msg.pbo", I18n.t(pboNames[pboMode]))
                                 : I18n.t("perf_stats.msg.nopbo"));
            break;

        case "reset":
            resetStats();
            setInfo(I18n.t("perf_stats.msg.reset"));
            break;

        case "compact":
            System.doCompact(clAll);
            sampleMemory();
            redrawMemory();
            setInfo(I18n.t("perf_stats.msg.compact"));
            break;

        case "gcache":
            System.clearGraphicCache();
            sampleMemory();
            redrawMemory();
            setInfo(I18n.t("perf_stats.msg.gcache"));
            break;

        case "peak":
            if (typeof System.resetMemoryPeak != "undefined") {
                System.resetMemoryPeak();
                sampleMemory();
                redrawMemory();
                setInfo(I18n.t("perf_stats.msg.peak"));
            } else {
                setInfo(I18n.t("perf_stats.msg.nopeak"));
            }
            break;

        case "overlay":
            // System.setMemoryOverlay は SDL3 ビルド限定 (他では何もしない)
            memOverlay = (payload == true);
            if (typeof System.setMemoryOverlay != "undefined") {
                System.setMemoryOverlay(memOverlay);
                setInfo(I18n.t("perf_stats.msg.overlay",
                               I18n.t(memOverlay ? "perf_stats.msg.shown" : "perf_stats.msg.hidden")));
            } else {
                setInfo(I18n.t("perf_stats.msg.nooverlay"));
            }
            break;
        }
    }

    function onDemoTest()
    {
        var s = System.renderStats;
        var has = (s !== void) ? 1 : 0;
        var mem = (typeof System.getSystemAllocatorInfo != "undefined") ? 1 : 0;
        dm(@"@demotest:perf_stats renderStats=${has} frames=${has ? s.frames : 0} allocinfo=${mem} pbo=${pboAvailable ? 1 : 0}");
    }

    // ------------------------------------------------------------------
    function panelDict()
    {
        return %[
            size : [320, 470], background : [26, 30, 40, 236],
            align : "bottom_right", margin : 16,
            content : %[ type : "margin", padding : 14, child : %[ type : "vtile", children : [
                %[ type : "vsize", height : 0, child : %[ type : "hspacer", width : 288 ] ],
                %[ type : "align_center", child : %[ type : "label", text : I18n.t("perf_stats.panel.title"), size_scale : 1.2 ] ],
                %[ type : "vspacer", height : 8 ],
                %[ type : "label", text : I18n.t("perf_stats.panel.load") ],
                %[ type : "slider_with_range", id : "load", min : 0, max : 3, initial : loadMode ],
                %[ type : "vspacer", height : 6 ],
                %[ type : "label", text : I18n.t("perf_stats.panel.count") ],
                %[ type : "slider_with_range", id : "count", min : 1, max : 200, initial : rectCount ],
                %[ type : "vspacer", height : 6 ],
                %[ type : "label", text : I18n.t("perf_stats.panel.pbo") ],
                %[ type : "slider_with_range", id : "pbo", min : 0, max : 2, initial : pboMode ],
                %[ type : "vspacer", height : 10 ],
                %[ type : "button", id : "reset", text : I18n.t("perf_stats.panel.reset") ],
                %[ type : "vspacer", height : 6 ],
                %[ type : "htile", children : [
                    %[ type : "button", id : "compact", text : "doCompact" ],
                    %[ type : "hspacer", width : 8 ],
                    %[ type : "button", id : "gcache", text : I18n.t("perf_stats.panel.gcache") ]
                ] ],
                %[ type : "vspacer", height : 6 ],
                %[ type : "button", id : "peak", text : I18n.t("perf_stats.panel.peak") ],
                %[ type : "vspacer", height : 8 ],
                %[ type : "check_box", id : "overlay", text : I18n.t("perf_stats.panel.overlay"), value : false ]
            ] ] ]
        ];
    }
}
