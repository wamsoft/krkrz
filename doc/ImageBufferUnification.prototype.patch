diff --git a/common/visual/ImageFunction.cpp b/common/visual/ImageFunction.cpp
index 91d8434b..029bd6d0 100644
--- a/common/visual/ImageFunction.cpp
+++ b/common/visual/ImageFunction.cpp
@@ -1029,4 +1029,149 @@ tTJSNativeClass * TVPCreateNativeClass_ImageFunction()
 {
 	tTJSNativeClass *cls = new tTJSNC_ImageFunction();
 	return cls;
+}
+
+//---------------------------------------------------------------------------
+// [PROTOTYPE] ImageBuffer
+//---------------------------------------------------------------------------
+tjs_uint32 tTJSNC_ImageBuffer::ClassID = -1;
+
+tjs_error TJS_INTF_METHOD tTJSNI_ImageBuffer::Construct(tjs_int numparams,
+	tTJSVariant **param, iTJSDispatch2 *tjs_obj)
+{
+	// 派生 (Layer/Bitmap) のコンストラクタ引数がそのまま流れてくるので無視する
+	return TJS_S_OK;
+}
+
+void TJS_INTF_METHOD tTJSNI_ImageBuffer::Invalidate()
+{
+	OwnerBitmap = nullptr;
+	OwnerLayer = nullptr;
+}
+
+tTVPBaseBitmap* tTJSNI_ImageBuffer::GetTargetBitmap() const
+{
+	if( OwnerBitmap ) return OwnerBitmap->GetBitmap();
+	if( OwnerLayer )  return OwnerLayer->GetMainImage();
+	return nullptr;
+}
+
+// objthis から実体を解決できるか (検証項目 2) を試すヘルパ。
+// 解決できた種別を文字列で返す。
+static ttstr TVPProbeResolveFromObjThis(iTJSDispatch2 *objthis)
+{
+	if( !objthis ) return ttstr(TJS_W("objthis=null"));
+
+	tTJSNI_Bitmap *bmp = nullptr;
+	if( TJS_SUCCEEDED(objthis->NativeInstanceSupport(TJS_NIS_GETINSTANCE,
+			tTJSNC_Bitmap::ClassID, (iTJSNativeInstance**)&bmp)) && bmp )
+		return ttstr(TJS_W("Bitmap"));
+
+	tTJSNI_BaseLayer *lay = nullptr;
+	if( TJS_SUCCEEDED(objthis->NativeInstanceSupport(TJS_NIS_GETINSTANCE,
+			tTJSNC_Layer::ClassID, (iTJSNativeInstance**)&lay)) && lay )
+		return ttstr(TJS_W("Layer"));
+
+	tTJSNI_ImageBuffer *ib = nullptr;
+	if( TJS_SUCCEEDED(objthis->NativeInstanceSupport(TJS_NIS_GETINSTANCE,
+			tTJSNC_ImageBuffer::ClassID, (iTJSNativeInstance**)&ib)) && ib )
+		return ttstr(TJS_W("ImageBuffer(super instance only)"));
+
+	return ttstr(TJS_W("none"));
+}
+
+tTJSNC_ImageBuffer::tTJSNC_ImageBuffer() : inherited(TJS_W("ImageBuffer"))
+{
+	TJS_BEGIN_NATIVE_MEMBERS(ImageBuffer)
+	TJS_DECL_EMPTY_FINALIZE_METHOD
+//----------------------------------------------------------------------
+TJS_BEGIN_NATIVE_CONSTRUCTOR_DECL(/*var.name*/_this, /*var.type*/tTJSNI_ImageBuffer,
+	/*TJS class name*/ImageBuffer)
+{
+	return TJS_S_OK;
+}
+TJS_END_NATIVE_CONSTRUCTOR_DECL(/*TJS class name*/ImageBuffer)
+//----------------------------------------------------------------------
+// 検証(2)(4): objthis の正体と、後方参照経由での実体解決を報告する
+TJS_BEGIN_NATIVE_METHOD_DECL(/*func. name*/ibProbe)
+{
+	TJS_GET_NATIVE_INSTANCE(/*var. name*/_this, /*var. type*/tTJSNI_ImageBuffer);
+
+	ttstr via = TVPProbeResolveFromObjThis(objthis);
+
+	ttstr owner(TJS_W("none"));
+	if( _this->GetOwnerBitmap() ) owner = TJS_W("Bitmap");
+	else if( _this->GetOwnerLayer() ) owner = TJS_W("Layer");
+
+	tTVPBaseBitmap *bmp = _this->GetTargetBitmap();
+	ttstr size(TJS_W("-"));
+	if( bmp ) size = ttstr((tjs_int)bmp->GetWidth()) + TJS_W("x") + ttstr((tjs_int)bmp->GetHeight());
+
+	if( result )
+		*result = ttstr(TJS_W("objthis->")) + via
+			+ TJS_W(" / owner=") + owner
+			+ TJS_W(" / size=") + size;
+	return TJS_S_OK;
+}
+TJS_END_NATIVE_METHOD_DECL(/*func. name*/ibProbe)
+//----------------------------------------------------------------------
+// 検証(3): Layer / Bitmap に同名 (fillRect) がある場合の shadow 確認用。
+// ImageBuffer 側が呼ばれたら分かるように文字列を返すだけにする。
+TJS_BEGIN_NATIVE_METHOD_DECL(/*func. name*/fillRect)
+{
+	if( result ) *result = ttstr(TJS_W("ImageBuffer::fillRect"));
+	return TJS_S_OK;
+}
+TJS_END_NATIVE_METHOD_DECL(/*func. name*/fillRect)
+//----------------------------------------------------------------------
+// 実処理を基底に置けるかの確認: 後方参照経由で実体へ書き込む
+TJS_BEGIN_NATIVE_METHOD_DECL(/*func. name*/ibFill)
+{
+	TJS_GET_NATIVE_INSTANCE(/*var. name*/_this, /*var. type*/tTJSNI_ImageBuffer);
+	if(numparams < 1) return TJS_E_BADPARAMCOUNT;
+
+	tTVPBaseBitmap *bmp = _this->GetTargetBitmap();
+	if( !bmp ) return TJS_E_INVALIDPARAM;
+
+	tjs_uint32 value = static_cast<tjs_uint32>((tjs_int64)*param[0]);
+	tTVPRect r(0, 0, bmp->GetWidth(), bmp->GetHeight());
+	bmp->Fill(r, value);
+	return TJS_S_OK;
+}
+TJS_END_NATIVE_METHOD_DECL(/*func. name*/ibFill)
+//----------------------------------------------------------------------
+
+	TJS_END_NATIVE_MEMBERS
+}
+
+tTJSNativeInstance *tTJSNC_ImageBuffer::CreateNativeInstance()
+{
+	return new tTJSNI_ImageBuffer();
+}
+
+tTJSNativeClass * TVPCreateNativeClass_ImageBuffer()
+{
+	return new tTJSNC_ImageBuffer();
+}
+
+static tTJSNI_ImageBuffer* TVPGetImageBufferInstance(iTJSDispatch2 *tjs_obj)
+{
+	if( !tjs_obj ) return nullptr;
+	tTJSNI_ImageBuffer *ib = nullptr;
+	if( TJS_SUCCEEDED(tjs_obj->NativeInstanceSupport(TJS_NIS_GETINSTANCE,
+			tTJSNC_ImageBuffer::ClassID, (iTJSNativeInstance**)&ib)) )
+		return ib;
+	return nullptr;
+}
+
+void TVPLinkImageBufferOwner(iTJSDispatch2 *tjs_obj, tTJSNI_Bitmap* b)
+{
+	tTJSNI_ImageBuffer *ib = TVPGetImageBufferInstance(tjs_obj);
+	if( ib ) ib->SetOwnerBitmap(b);
+}
+
+void TVPLinkImageBufferOwner(iTJSDispatch2 *tjs_obj, tTJSNI_BaseLayer* l)
+{
+	tTJSNI_ImageBuffer *ib = TVPGetImageBufferInstance(tjs_obj);
+	if( ib ) ib->SetOwnerLayer(l);
 }
