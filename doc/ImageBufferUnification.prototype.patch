 };
 
 extern tTJSNativeClass * TVPCreateNativeClass_ImageFunction();
+
+//---------------------------------------------------------------------------
+// [PROTOTYPE] ImageBuffer : Layer / Bitmap の共通ネイティブ基底クラス検証用
+//---------------------------------------------------------------------------
+// 検証項目:
+//  (1) tTJSNativeClass::SetSuper() で Layer / Bitmap に共通基底を持たせられるか
+//  (2) 基底クラスのメソッド呼び出し時に objthis が「派生インスタンス」なのか
+//      「super インスタンス」なのか (= objthis から実体を解決できるか)
+//  (3) 派生に同名メンバがある場合に派生側が優先されるか (shadow)
+//  (4) NativeInstanceSupport が super へフォールスルーするか
+//  (5) instanceof が super まで見えるか
+class tTJSNI_ImageBuffer : public tTJSNativeInstance
+{
+	typedef tTJSNativeInstance inherited;
+
+	// 派生 (Layer / Bitmap) のネイティブインスタンスへの後方参照。
+	// 派生側の Construct から SetOwner() で注入される想定。
+	class tTJSNI_Bitmap*    OwnerBitmap;
+	class tTJSNI_BaseLayer* OwnerLayer;
+
+public:
+	tTJSNI_ImageBuffer() : OwnerBitmap(nullptr), OwnerLayer(nullptr) {}
+	tjs_error TJS_INTF_METHOD
+		Construct(tjs_int numparams, tTJSVariant **param,
+			iTJSDispatch2 *tjs_obj);
+	void TJS_INTF_METHOD Invalidate();
+
+	void SetOwnerBitmap(class tTJSNI_Bitmap* b) { OwnerBitmap = b; }
+	void SetOwnerLayer(class tTJSNI_BaseLayer* l) { OwnerLayer = l; }
+	class tTJSNI_Bitmap*    GetOwnerBitmap() const { return OwnerBitmap; }
+	class tTJSNI_BaseLayer* GetOwnerLayer() const { return OwnerLayer; }
+
+	// 後方参照経由で実体のビットマップを得る
+	tTVPBaseBitmap* GetTargetBitmap() const;
+};
+
+class tTJSNC_ImageBuffer : public tTJSNativeClass
+{
+	typedef tTJSNativeClass inherited;
+
+public:
+	tTJSNC_ImageBuffer();
+	static tjs_uint32 ClassID;
+
+protected:
+	tTJSNativeInstance *CreateNativeInstance();
+};
+
+extern tTJSNativeClass * TVPCreateNativeClass_ImageBuffer();
+
+// Layer / Bitmap の Construct から呼ばれ、super の ImageBuffer インスタンスへ
+// 後方参照を注入する。super が無ければ何もしない。
+extern void TVPLinkImageBufferOwner(iTJSDispatch2 *tjs_obj, class tTJSNI_Bitmap* b);
+extern void TVPLinkImageBufferOwner(iTJSDispatch2 *tjs_obj, class tTJSNI_BaseLayer* l);
+
 #endif // ImageFunctionH
